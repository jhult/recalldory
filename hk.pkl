amends "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["inko-fmt"] {
        glob = "*.inko"
        check = "inko fmt --check {{files}}"
        fix = "inko fmt {{files}}"
    }
    ["inko-test"] {
        glob = "*.inko"
        check = "inko test"
    }
}

hooks {
    ["pre-commit"] {
        steps {
            ["inko-fmt"] = linters["inko-fmt"]
            ["inko-test"] = linters["inko-test"]
        }
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
