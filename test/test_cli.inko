import recalldory.cli (
  FlagParser, int_parse, parse_add, parse_agents_md, parse_contradictions,
  parse_feedback, parse_forget, parse_history, parse_hook, parse_import,
  parse_init, parse_list, parse_maintain, parse_pin, parse_recall, parse_unpin,
  parse_update, validate_scope, validate_status,
)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('int_parse parses single digit', fn (t) {
    match int_parse('5') {
      case Some(v) -> t.equal(v, 5)
      case None -> t.true(false)
    }
  })

  t.test('int_parse parses multi-digit', fn (t) {
    match int_parse('12345') {
      case Some(v) -> t.equal(v, 12345)
      case None -> t.true(false)
    }
  })

  t.test('int_parse parses zero', fn (t) {
    match int_parse('0') {
      case Some(v) -> t.equal(v, 0)
      case None -> t.true(false)
    }
  })

  t.test('int_parse parses negative number', fn (t) {
    match int_parse('-42') {
      case Some(v) -> t.equal(v, -42)
      case None -> t.true(false)
    }
  })

  t.test('int_parse parses negative zero', fn (t) {
    match int_parse('-0') {
      case Some(v) -> t.equal(v, 0)
      case None -> t.true(false)
    }
  })

  t.test('int_parse returns None for empty string', fn (t) {
    match int_parse('') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  t.test('int_parse returns None for letters', fn (t) {
    match int_parse('abc') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  t.test('int_parse returns None for mixed alphanum', fn (t) {
    match int_parse('12abc') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  t.test('int_parse returns None for lone minus', fn (t) {
    match int_parse('-') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  t.test('int_parse returns None for leading plus', fn (t) {
    match int_parse('+5') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  t.test('int_parse returns None for whitespace', fn (t) {
    match int_parse(' ') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  t.test('int_parse returns None for decimal', fn (t) {
    match int_parse('3.14') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  t.test('int_parse parses large number', fn (t) {
    match int_parse('999999999') {
      case Some(v) -> t.equal(v, 999999999)
      case None -> t.true(false)
    }
  })

  t.test('int_parse returns None for overflow', fn (t) {
    match int_parse('99999999999999999999') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  t.test('int_parse returns None for negative overflow', fn (t) {
    match int_parse('-99999999999999999999') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  t.test('int_parse parses Int.MIN', fn (t) {
    match int_parse('-9223372036854775808') {
      case Some(v) -> t.equal(v, -9223372036854775808)
      case None -> t.true(false)
    }
  })

  t.test('int_parse parses Int.MAX', fn (t) {
    match int_parse('9223372036854775807') {
      case Some(v) -> t.equal(v, 9223372036854775807)
      case None -> t.true(false)
    }
  })

  t.test('int_parse returns None for Int.MAX + 1', fn (t) {
    match int_parse('9223372036854775808') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  t.test('int_parse returns None for Int.MIN - 1', fn (t) {
    match int_parse('-9223372036854775809') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  # --- FlagParser ---

  t.test('FlagParser string_flag returns value', fn (t) {
    let args = ['add', 'content', '--tags', 'a,b', '--scope', 'global']
    let parser = FlagParser.new(args, 0)

    t.equal(parser.string_flag('--tags'), 'a,b')
    t.equal(parser.string_flag('--scope'), 'global')
  })

  t.test('FlagParser string_flag returns empty for missing flag', fn (t) {
    let args = ['add', 'content']
    let parser = FlagParser.new(args, 0)

    t.equal(parser.string_flag('--tags'), '')
  })

  t.test('FlagParser bool_flag detects presence', fn (t) {
    let args = ['add', 'content', '--pin']
    let parser = FlagParser.new(args, 0)

    t.equal(parser.bool_flag('--pin'), true)
    t.equal(parser.bool_flag('--dry-run'), false)
  })

  t.test('FlagParser int_flag parses integer', fn (t) {
    let args = ['recall', 'query', '--top', '5']
    let parser = FlagParser.new(args, 0)

    match parser.int_flag('--top') {
      case Some(v) -> t.equal(v, 5)
      case None -> t.true(false)
    }
  })

  t.test('FlagParser int_flag returns None for missing flag', fn (t) {
    let args = ['recall', 'query']
    let parser = FlagParser.new(args, 0)

    match parser.int_flag('--top') {
      case Some(_) -> t.true(false)
      case None -> t.true(true)
    }
  })

  t.test('FlagParser positional returns first non-flag arg', fn (t) {
    let args = ['add', 'my content here']
    let parser = FlagParser.new(args, 1)

    t.equal(parser.positional, 'my content here')
  })

  t.test('FlagParser positional skips flags', fn (t) {
    let args = ['--pin', 'content']
    let parser = FlagParser.new(args, 0)

    t.equal(parser.positional, '')
  })

  # --- validate_scope ---

  t.test('validate_scope accepts project', fn (t) {
    t.equal(validate_scope('project'), true)
  })

  t.test('validate_scope accepts global', fn (t) {
    t.equal(validate_scope('global'), true)
  })

  t.test('validate_scope accepts user', fn (t) {
    t.equal(validate_scope('user'), true)
  })

  t.test('validate_scope rejects invalid scope', fn (t) {
    t.equal(validate_scope('foo'), false)
    t.equal(validate_scope(''), false)
    t.equal(validate_scope('PROJECT'), false)
  })

  # --- validate_status ---

  t.test('validate_status accepts active', fn (t) {
    t.equal(validate_status('active'), true)
  })

  t.test('validate_status accepts pinned', fn (t) {
    t.equal(validate_status('pinned'), true)
  })

  t.test('validate_status accepts superseded', fn (t) {
    t.equal(validate_status('superseded'), true)
  })

  t.test('validate_status accepts anti-pattern', fn (t) {
    t.equal(validate_status('anti-pattern'), true)
  })

  t.test('validate_status rejects invalid status', fn (t) {
    t.equal(validate_status('foo'), false)
    t.equal(validate_status(''), false)
    t.equal(validate_status('ACTIVE'), false)
  })

  # --- parse_add ---

  t.test('parse_add basic', fn (t) {
    match parse_add(['add', 'some content']) {
      case Ok(Db(Add(content, tags, scope, pin, source))) -> {
        t.equal(content, 'some content')
        t.equal(tags, '')
        t.equal(scope, 'project')
        t.equal(pin, false)
        t.equal(source, '')
      }
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_add with all flags', fn (t) {
    let args = [
      'add',
      'content',
      '--tags',
      't1,t2',
      '--scope',
      'global',
      '--pin',
      '--source',
      'https://example.com',
    ]

    match parse_add(args) {
      case Ok(Db(Add(content, tags, scope, pin, source))) -> {
        t.equal(content, 'content')
        t.equal(tags, 't1,t2')
        t.equal(scope, 'global')
        t.equal(pin, true)
        t.equal(source, 'https://example.com')
      }
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_add missing content is an error', fn (t) {
    match parse_add(['add']) {
      case Ok(_) -> t.true(false)
      case Error(msg) -> t.true(msg.contains?('missing <content>'))
    }
  })

  t.test('parse_add invalid scope names the argument', fn (t) {
    match parse_add(['add', 'x', '--scope', 'bogus']) {
      case Ok(_) -> t.true(false)
      case Error(msg) -> {
        t.true(msg.contains?('bogus'))
        t.true(msg.contains?('--scope'))
      }
    }
  })

  # --- parse_recall ---

  t.test('parse_recall defaults top to 10', fn (t) {
    match parse_recall(['recall', 'search query']) {
      case Ok(Db(Recall(query, scope, top))) -> {
        t.equal(query, 'search query')
        t.equal(scope, '')
        t.equal(top, 10)
      }
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_recall parses --top and --scope', fn (t) {
    match parse_recall(['recall', 'q', '--top', '5', '--scope', 'global']) {
      case Ok(Db(Recall(query, scope, top))) -> {
        t.equal(query, 'q')
        t.equal(scope, 'global')
        t.equal(top, 5)
      }
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_recall rejects negative top', fn (t) {
    match parse_recall(['recall', 'query', '--top', '-1']) {
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(true)
    }
  })

  t.test('parse_recall rejects zero top', fn (t) {
    match parse_recall(['recall', 'query', '--top', '0']) {
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(true)
    }
  })

  # --- parse_list ---

  t.test('parse_list defaults limit to 50', fn (t) {
    match parse_list(['list']) {
      case Ok(Db(List(scope, status, limit, older_than))) -> {
        t.equal(scope, '')
        t.equal(status, '')
        t.equal(limit, 50)

        match older_than {
          case Some(_) -> t.true(false)
          case None -> t.true(true)
        }
      }
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_list parses filters', fn (t) {
    match
      parse_list(
        [
          'list',
          '--scope',
          'global',
          '--status',
          'pinned',
          '--limit',
          '7',
          '--older-than',
          '30',
        ],
      )
    {
      case Ok(Db(List(scope, status, limit, older_than))) -> {
        t.equal(scope, 'global')
        t.equal(status, 'pinned')
        t.equal(limit, 7)

        match older_than {
          case Some(v) -> t.equal(v, 30)
          case None -> t.true(false)
        }
      }
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_list rejects invalid status', fn (t) {
    match parse_list(['list', '--status', 'invalid']) {
      case Ok(_) -> t.true(false)
      case Error(msg) -> t.true(msg.contains?('invalid'))
    }
  })

  # --- parse_forget / parse_pin / parse_unpin ---

  t.test('parse_forget basic', fn (t) {
    match parse_forget(['forget', '42']) {
      case Ok(Db(Forget(id))) -> t.equal(id, 42)
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_forget rejects non-integer and names the argument', fn (t) {
    match parse_forget(['forget', 'abc']) {
      case Ok(_) -> t.true(false)
      case Error(msg) -> t.true(msg.contains?('abc'))
    }
  })

  t.test('parse_pin basic', fn (t) {
    match parse_pin(['pin', '7']) {
      case Ok(Db(Pin(id))) -> t.equal(id, 7)
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_unpin basic', fn (t) {
    match parse_unpin(['unpin', '7']) {
      case Ok(Db(Unpin(id))) -> t.equal(id, 7)
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  # --- parse_feedback ---

  t.test('parse_feedback helpful', fn (t) {
    match parse_feedback(['feedback', '1', 'helpful']) {
      case Ok(Db(Feedback(id, kind))) -> {
        t.equal(id, 1)
        t.equal(kind, 'helpful')
      }
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test(
    'parse_feedback accepts any type (validation in feedback_memory)',
    fn (t) {
      match parse_feedback(['feedback', '1', 'invalid']) {
        case Ok(_) -> t.true(true)
        case Error(_) -> t.true(false)
      }
    },
  )

  t.test('parse_feedback missing type is an error', fn (t) {
    match parse_feedback(['feedback', '1']) {
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(true)
    }
  })

  # --- parse_maintain ---

  t.test('parse_maintain without dry-run', fn (t) {
    match parse_maintain(['maintain']) {
      case Ok(Db(Maintain(dry))) -> t.equal(dry, false)
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_maintain with dry-run', fn (t) {
    match parse_maintain(['maintain', '--dry-run']) {
      case Ok(Db(Maintain(dry))) -> t.equal(dry, true)
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  # --- parse_agents_md ---

  t.test('parse_agents_md defaults path to .', fn (t) {
    match parse_agents_md(['agents-md']) {
      case Ok(Db(AgentsMd(path))) -> t.equal(path, '.')
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_agents_md takes --path', fn (t) {
    match parse_agents_md(['agents-md', '--path', '/tmp/x']) {
      case Ok(Db(AgentsMd(path))) -> t.equal(path, '/tmp/x')
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  # --- parse_import ---

  t.test('parse_import takes a file', fn (t) {
    match parse_import(['import', 'backup.json']) {
      case Ok(Db(Import(file))) -> t.equal(file, 'backup.json')
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_import without a file is an error', fn (t) {
    match parse_import(['import']) {
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(true)
    }
  })

  # --- parse_hook ---

  t.test('parse_hook register', fn (t) {
    match parse_hook(['hook', 'register', '--titles']) {
      case Ok(HookRegister(titles)) -> t.equal(titles, true)
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_hook inject', fn (t) {
    match parse_hook(['hook', 'inject']) {
      case Ok(HookInject(titles)) -> t.equal(titles, false)
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_hook unregister', fn (t) {
    match parse_hook(['hook', 'unregister']) {
      case Ok(HookUnregister) -> t.true(true)
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_hook unknown subcommand is an error', fn (t) {
    match parse_hook(['hook', 'bogus']) {
      case Ok(_) -> t.true(false)
      case Error(msg) -> t.true(msg.contains?('bogus'))
    }
  })

  # --- parse_init ---

  t.test('parse_init default', fn (t) {
    match parse_init(['init']) {
      case Ok(Init(no_gitignore)) -> t.equal(no_gitignore, false)
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_init --no-gitignore', fn (t) {
    match parse_init(['init', '--no-gitignore']) {
      case Ok(Init(no_gitignore)) -> t.equal(no_gitignore, true)
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  # --- parse_update ---

  t.test('parse_update basic', fn (t) {
    match parse_update(['update', '5', '--content', 'new content']) {
      case Ok(Db(Update(id, content, tags, scope, source))) -> {
        t.equal(id, 5)
        t.equal(content, 'new content')
        t.equal(tags, '')
        t.equal(scope, '')
        t.equal(source, '')
      }
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_update accepts positional content', fn (t) {
    match parse_update(['update', '5', 'positional content']) {
      case Ok(Db(Update(id, content, _, _, _))) -> {
        t.equal(id, 5)
        t.equal(content, 'positional content')
      }
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_update rejects non-integer id', fn (t) {
    match parse_update(['update', 'abc']) {
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(true)
    }
  })

  t.test('parse_update with nothing to change is an error', fn (t) {
    match parse_update(['update', '5']) {
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(true)
    }
  })

  # --- parse_history ---

  t.test('parse_history basic', fn (t) {
    match parse_history(['history', '9']) {
      case Ok(Db(History(id))) -> t.equal(id, 9)
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  # --- parse_contradictions ---

  t.test('parse_contradictions without --resolve', fn (t) {
    match parse_contradictions(['contradictions']) {
      case Ok(Db(Contradictions(resolve))) -> {
        match resolve {
          case Some(_) -> t.true(false)
          case None -> t.true(true)
        }
      }
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_contradictions with --resolve', fn (t) {
    match parse_contradictions(['contradictions', '--resolve', '3']) {
      case Ok(Db(Contradictions(resolve))) -> {
        match resolve {
          case Some(v) -> t.equal(v, 3)
          case None -> t.true(false)
        }
      }
      case Ok(_) -> t.true(false)
      case Error(_) -> t.true(false)
    }
  })
}
