import std.env
import std.stdio (Stdout)
import recalldory.memstore_helpers (
  STATUS_ACTIVE, STATUS_PINNED, STATUS_SUPERSEDED, STATUS_ANTI_PATTERN,
)

# Valid scope values
let VALID_SCOPES = ['project', 'global', 'user']

fn pub validate_scope(scope: String) -> Bool {
  let mut valid = false

  for s in VALID_SCOPES.iter {
    if s == scope {
      valid = true
      break
    }
  }

  valid
}

# Valid status values for list command
let VALID_STATUSES = [STATUS_ACTIVE, STATUS_PINNED, STATUS_SUPERSEDED, STATUS_ANTI_PATTERN]

fn pub validate_status(status: String) -> Bool {
  let mut valid = false

  for s in VALID_STATUSES.iter {
    if s == status {
      valid = true
      break
    }
  }

  valid
}

# Parses flag arguments (--flag value) from a subcommand's argument slice.
type pub FlagParser {
  let @args: Array[String]
  let @start: Int

  fn pub static new(args: Array[String], start: Int) -> FlagParser {
    FlagParser(args: args, start: start)
  }

  # Find the next argument after --name and return it as a string.
  fn pub string_flag(name: String) -> String {
    let mut i = @start

    while i < @args.size {
      match @args.get(i) {
        case Ok(arg) -> {
          if arg == name {
            if i + 1 < @args.size {
              match @args.get(i + 1) {
                case Ok(v) -> return v
                case Error(_) -> return ''
              }
            }

            return ''
          }
        }
        case Error(_) -> {}
      }

      i = i + 1
    }

    ''
  }

  # Check if --name is present in the arguments.
  fn pub bool_flag(name: String) -> Bool {
    let mut i = @start

    while i < @args.size {
      match @args.get(i) {
        case Ok(arg) -> if arg == name { return true }
        case Error(_) -> {}
      }

      i = i + 1
    }

    false
  }

  # Parse the next argument after --name as an integer.
  fn pub int_flag(name: String) -> Option[Int] {
    let val = string_flag(name)

    match int_parse(val) {
      case Some(v) -> Option.Some(v)
      case None -> Option.None
    }
  }

  # Return the first non-flag argument at the start position, or empty string.
  fn pub positional -> String {
    match @args.get(@start) {
      case Ok(arg) -> {
        let bytes = arg.to_byte_array

        match bytes.get(0) {
          case Ok(45) -> ''
          case _ -> arg
        }
      }
      case Error(_) -> ''
    }
  }
}

# Parse a required integer argument at the given position.
fn parse_int_arg(args: ref Array[String], pos: Int) -> Option[Int] {
  match args.get(pos) {
    case Ok(s) -> int_parse(s)
    case Error(_) -> Option.None
  }
}

# Commands that require a database connection
type pub enum DbCommand {
  case Add(String, String, String, Bool)
  case Recall(String, String, Int)
  case List(String, String, Int)
  case Forget(Int)
  case Pin(Int)
  case Unpin(Int)
  case Feedback(Int, String)
  case Maintain(Bool)
  case AgentsMd(String)
  case Stats
  case Export
  case Import(String)
  case Update(Int, String, String, String)
  case History(Int)
  case Contradictions(Option[Int])
  case RebuildFts
}

# Top-level command: either standalone or DB-backed
type pub enum Command {
  case Help
  case HookPostCompact
  case HookInstall
  case Db(DbCommand)
}

# Result of parsing CLI arguments: the resolved command and --global flag.
type pub ParsedArgs {
  let pub @command: Command
  let pub @global: Bool
}

impl ParsedArgs {
  # Consume and return the parsed Command.
  fn pub move into_command -> Command {
    @command
  }
}

# Parse CLI arguments into a ParsedArgs. Returns None if help should be shown.
fn pub parse_args -> Option[ParsedArgs] {
  let raw_args = env.arguments
  let mut global = false
  let mut help = false
  let mut args: Array[String] = []
  let mut i = 0

  while i < raw_args.size {
    match raw_args.get(i) {
      case Ok(arg) -> {
        if arg == '--global' {
          global = true
        } else if arg == '--help' or arg == '-h' {
          help = true
        } else {
          args.push(arg.clone)
        }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  if help or args.size < 1 {
    return Option.Some(ParsedArgs(command: Command.Help, global: global))
  }

  let cmd = match args.get(0) {
    case Ok(cmd) -> {
      match cmd {
        case 'help' -> Option.Some(Command.Help)
        case 'add' -> parse_add(args)
        case 'recall' -> parse_recall(args)
        case 'list' -> parse_list(args)
        case 'forget' -> parse_forget(args)
        case 'pin' -> parse_pin(args)
        case 'unpin' -> parse_unpin(args)
        case 'feedback' -> parse_feedback(args)
        case 'maintain' -> parse_maintain(args)
        case 'agents-md' -> parse_agents_md(args)
        case 'stats' -> Option.Some(Command.Db(DbCommand.Stats))
        case 'export' -> Option.Some(Command.Db(DbCommand.Export))
        case 'import' -> parse_import(args)
        case 'hook' -> parse_hook(args)
        case 'update' -> parse_update(args)
        case 'history' -> parse_history(args)
        case 'contradictions' -> parse_contradictions(args)
        case 'rebuild-fts' -> Option.Some(Command.Db(DbCommand.RebuildFts))
        case _ -> Option.None
      }
    }
    case Error(_) -> Option.None
  }

  match cmd {
    case Some(c) -> Option.Some(ParsedArgs(command: c, global: global))
    case None -> Option.Some(ParsedArgs(command: Command.Help, global: false))
  }
}

fn pub parse_add(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  let content = match args.get(1) {
    case Ok(c) -> c
    case Error(_) -> return Option.None
  }

  let parser = FlagParser.new(args, 2)
  let tags = parser.string_flag('--tags')
  let scope = parser.string_flag('--scope')
  let pin = parser.bool_flag('--pin')

  if scope != '' and !validate_scope(scope) { return Option.None }

  let final_scope = if scope != '' { scope } else { 'project' }

  Option.Some(Command.Db(DbCommand.Add(content, tags, final_scope, pin)))
}

fn pub parse_recall(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  let query = match args.get(1) {
    case Ok(q) -> q
    case Error(_) -> return Option.None
  }

  let parser = FlagParser.new(args, 2)
  let scope = parser.string_flag('--scope')

  let top = match parser.int_flag('--top') {
    case Some(v) -> {
      if v < 1 { return Option.None }
      v
    }
    case None -> 10
  }

  if scope != '' and !validate_scope(scope) { return Option.None }

  Option.Some(Command.Db(DbCommand.Recall(query, scope, top)))
}

fn pub parse_list(args: Array[String]) -> Option[Command] {
  let parser = FlagParser.new(args, 1)
  let scope = parser.string_flag('--scope')
  let status = parser.string_flag('--status')

  let limit = match parser.int_flag('--limit') {
    case Some(v) -> {
      if v < 1 { return Option.None }
      v
    }
    case None -> 50
  }

  if scope != '' and !validate_scope(scope) { return Option.None }

  if status != '' and !validate_status(status) { return Option.None }

  Option.Some(Command.Db(DbCommand.List(scope, status, limit)))
}

fn pub parse_forget(args: Array[String]) -> Option[Command] {
  match parse_int_arg(ref args, 1) {
    case Some(id) -> Option.Some(Command.Db(DbCommand.Forget(id)))
    case None -> Option.None
  }
}

fn parse_pin(args: Array[String]) -> Option[Command] {
  match parse_int_arg(ref args, 1) {
    case Some(id) -> Option.Some(Command.Db(DbCommand.Pin(id)))
    case None -> Option.None
  }
}

fn parse_unpin(args: Array[String]) -> Option[Command] {
  match parse_int_arg(ref args, 1) {
    case Some(id) -> Option.Some(Command.Db(DbCommand.Unpin(id)))
    case None -> Option.None
  }
}

fn pub parse_feedback(args: Array[String]) -> Option[Command] {
  if args.size < 3 { return Option.None }

  let id = match parse_int_arg(args, 1) {
    case Some(i) -> i
    case None -> return Option.None
  }

  let feedback_type = match args.get(2) {
    case Ok(t) -> t
    case Error(_) -> return Option.None
  }

  # Don't validate here - let feedback_memory return a proper error message
  Option.Some(Command.Db(DbCommand.Feedback(id, feedback_type)))
}

fn pub parse_maintain(args: Array[String]) -> Option[Command] {
  let parser = FlagParser.new(args, 1)
  let dry_run = parser.bool_flag('--dry-run')

  Option.Some(Command.Db(DbCommand.Maintain(dry_run)))
}

fn parse_agents_md(args: Array[String]) -> Option[Command] {
  let parser = FlagParser.new(args, 1)
  let path = parser.string_flag('--path')

  let final_path = if path != '' { path } else { '.' }

  Option.Some(Command.Db(DbCommand.AgentsMd(final_path)))
}

fn parse_import(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  match args.get(1) {
    case Ok(file) -> Option.Some(Command.Db(DbCommand.Import(file)))
    case Error(_) -> Option.None
  }
}

fn parse_hook(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  match args.get(1) {
    case Ok(sub) -> {
      match sub {
        case 'post-compact' -> Option.Some(Command.HookPostCompact)
        case 'install' -> Option.Some(Command.HookInstall)
        case _ -> Option.None
      }
    }
    case Error(_) -> Option.None
  }
}

fn pub int_parse(s: String) -> Option[Int] {
  let mut result: Int = 0
  let mut valid = false
  let mut negative = false
  let bytes = s.to_byte_array
  let mut i = 0

  # Check for leading minus sign
  if bytes.size > 0 {
    match bytes.get(0) {
      case Ok(b) if b == 45 -> {
        negative = true
        i = 1
      }
      case _ -> {}
    }
  }

  while i < bytes.size {
    match bytes.get(i) {
      case Ok(byte) -> {
        if byte >= 48 and byte <= 57 {
          let digit = byte - 48

          # Check for overflow before computing result * 10 + digit
          # Int.MAX = 9223372036854775807, Int.MIN = -9223372036854775808
          if negative {
            # For negative numbers, Int.MIN (-9223372036854775808) is the limit
            # Special case: when result == 922337203685477580 and digit == 8,
            # we'd compute 9223372036854775808 which overflows Int.MAX.
            # Return Int.MIN directly in this case.
            if result == 922337203685477580 and digit == 8 {
              # Ensure this is the last digit
              if i + 1 == bytes.size {
                return Option.Some(-9223372036854775808)
              } else {
                return Option.None
              }
            }
            if result > 922337203685477580 {
              return Option.None
            }
            if result == 922337203685477580 and digit > 8 {
              return Option.None
            }
          } else {
            # For positive numbers, Int.MAX (9223372036854775807) is the limit
            if result > 922337203685477580 {
              return Option.None
            }
            if result == 922337203685477580 and digit > 7 {
              return Option.None
            }
          }

          valid = true
          result = result * 10 + digit
        } else {
          return Option.None
        }
      }
      case Error(_) -> return Option.None
    }

    i = i + 1
  }

  if valid {
    if negative {
      Option.Some(0 - result)
    } else {
      Option.Some(result)
    }
  } else {
    Option.None
  }
}

fn pub parse_update(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  let id = match parse_int_arg(args, 1) {
    case Some(i) -> i
    case None -> return Option.None
  }

  let parser = FlagParser.new(args, 2)
  let positional = parser.positional
  let flag_content = parser.string_flag('--content')
  let tags = parser.string_flag('--tags')
  let scope = parser.string_flag('--scope')
  let content = if flag_content != '' { flag_content } else { positional }

  if content == '' and tags == '' and scope == '' { return Option.None }

  if scope != '' and !validate_scope(scope) { return Option.None }

  Option.Some(Command.Db(DbCommand.Update(id, content, tags, scope)))
}

fn parse_history(args: Array[String]) -> Option[Command] {
  match parse_int_arg(ref args, 1) {
    case Some(id) -> Option.Some(Command.Db(DbCommand.History(id)))
    case None -> Option.None
  }
}

fn parse_contradictions(args: Array[String]) -> Option[Command] {
  let parser = FlagParser.new(args, 1)
  let resolve_id = parser.int_flag('--resolve')

  Option.Some(Command.Db(DbCommand.Contradictions(resolve_id)))
}

fn pub print_help(out: Stdout) {
  let _ = out.print('recalldory - persistent memory for AI coding assistants\n')
  let _ = out.print('Usage: recalldory <command> [options] [--global]\n')
  let _ = out.print('\nCommands:')
  let _ = out.print('  add <content> [--tags T] [--scope S] [--pin]   Add a memory')
  let _ = out.print('  recall <query> [--scope S] [--top N]            Search memories')
  let _ = out.print('  list [--scope S] [--status S] [--limit N]       List memories')
  let _ = out.print('  update <id> [content] [--content C] [--tags T]  Update a memory')
  let _ = out.print('  forget <id>                                     Delete a memory')
  let _ = out.print('  pin <id>                                        Pin a memory')
  let _ = out.print('  unpin <id>                                      Unpin a memory')
  let _ = out.print('  feedback <id> <helpful|harmful>                 Give feedback')
  let _ = out.print('  maintain [--dry-run]                            Run maintenance')
  let _ = out.print('  stats                                           Show statistics')
  let _ = out.print('  export                                          Export as JSON')
  let _ = out.print(
    '  import <file>                                   Import from JSON',
  )
  let _ = out.print(
    '  history <id>                                    Show version history',
  )
  let _ = out.print(
    '  contradictions [--resolve <id>]                 Manage contradictions',
  )
  let _ = out.print(
    '  agents-md [--path P]                            Generate AGENTS.md',
  )
  let _ = out.print(
    '  rebuild-fts                                     Rebuild FTS index',
  )
  let _ = out.print(
    '  hook install                                    Install Claude hook',
  )
  let _ = out.print(
    '  hook post-compact                               Post-compact hook',
  )
  let _ = out.print('\nGlobal flag:')
  let _ = out.print(
    '  --global    Use global (~/.recalldory/) instead of project (.recalldory/) database',
  )
}
