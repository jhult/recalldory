import std.env

# Valid scope values
let VALID_SCOPES = ['project', 'global', 'user']

fn validate_scope(scope: String) -> Bool {
  let mut valid = false

  for s in VALID_SCOPES.iter {
    if s == scope {
      valid = true
      break
    }
  }

  valid
}

# Commands that require a database connection
type pub enum DbCommand {
  case Add(String, String, String, Bool)
  case Recall(String, String, Int)
  case List(String, String, Int)
  case Forget(Int)
  case Pin(Int)
  case Unpin(Int)
  case Feedback(Int, String)
  case Maintain(Bool)
  case AgentsMd(String)
  case Stats
  case Export
  case Import(String)
  case Update(Int, String, String, String)
  case History(Int)
  case Contradictions(Option[Int])
  case RebuildFts
}

# Top-level command: either standalone or DB-backed
type pub enum Command {
  case Help
  case HookPostCompact
  case HookInstall
  case Db(DbCommand)
}

type pub ParsedArgs {
  let pub @command: Command
  let pub @global: Bool
}

impl ParsedArgs {
  fn pub move into_command -> Command {
    @command
  }
}

fn pub parse_args -> Option[ParsedArgs] {
  let raw_args = env.arguments
  let mut global = false
  let mut args: Array[String] = []

  let mut i = 0

  while i < raw_args.size {
    match raw_args.get(i) {
      case Ok(arg) -> {
        if arg == '--global' { global = true } else { args.push(arg.clone) }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  if args.size < 1 {
    return Option.Some(ParsedArgs(command: Command.Help, global: global))
  }

  let cmd = match args.get(0) {
    case Ok(cmd) -> {
      match cmd {
        case '--help' -> Option.Some(Command.Help)
        case '-h' -> Option.Some(Command.Help)
        case 'help' -> Option.Some(Command.Help)
        case 'add' -> parse_add(args)
        case 'recall' -> parse_recall(args)
        case 'list' -> parse_list(args)
        case 'forget' -> parse_forget(args)
        case 'pin' -> parse_pin(args)
        case 'unpin' -> parse_unpin(args)
        case 'feedback' -> parse_feedback(args)
        case 'maintain' -> parse_maintain(args)
        case 'agents-md' -> parse_agents_md(args)
        case 'stats' -> Option.Some(Command.Db(DbCommand.Stats))
        case 'export' -> Option.Some(Command.Db(DbCommand.Export))
        case 'import' -> parse_import(args)
        case 'hook' -> parse_hook(args)
        case 'update' -> parse_update(args)
        case 'history' -> parse_history(args)
        case 'contradictions' -> parse_contradictions(args)
        case 'rebuild-fts' -> Option.Some(Command.Db(DbCommand.RebuildFts))
        case _ -> Option.None
      }
    }
    case Error(_) -> Option.None
  }

  match cmd {
    case Some(c) -> Option.Some(ParsedArgs(command: c, global: global))
    case None -> Option.Some(ParsedArgs(command: Command.Help, global: false))
  }
}

fn parse_add(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  let content = match args.get(1) {
    case Ok(c) -> c
    case Error(_) -> return Option.None
  }

  let mut tags = ''
  let mut scope = 'project'
  let mut pin = false

  let mut i = 2

  while i < args.size {
    match args.get(i) {
      case Ok(arg) -> {
        if arg == '--tags' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(t) -> {
              tags = t
              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else if arg == '--scope' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(s) -> {
              scope = s
              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else if arg == '--pin' {
          pin = true
          i = i + 1
        } else {
          i = i + 1
        }
      }
      case Error(_) -> i = i + 1
    }
  }

  # Validate scope
  if !validate_scope(scope) { return Option.None }

  Option.Some(Command.Db(DbCommand.Add(content, tags, scope, pin)))
}

fn parse_recall(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  let query = match args.get(1) {
    case Ok(q) -> q
    case Error(_) -> return Option.None
  }

  let mut scope = ''
  let mut top = 10

  let mut i = 2

  while i < args.size {
    match args.get(i) {
      case Ok(arg) -> {
        if arg == '--scope' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(s) -> {
              scope = s
              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else if arg == '--top' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(t) -> {
              match int_parse(t) {
                case Some(v) -> top = v
                case None -> {}
              }

              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else {
          i = i + 1
        }
      }
      case Error(_) -> i = i + 1
    }
  }

  if scope != '' {
    if !validate_scope(scope) { return Option.None }
  }

  Option.Some(Command.Db(DbCommand.Recall(query, scope, top)))
}

fn parse_list(args: Array[String]) -> Option[Command] {
  let mut scope = ''
  let mut status = ''
  let mut limit = 50

  let mut i = 1

  while i < args.size {
    match args.get(i) {
      case Ok(arg) -> {
        if arg == '--scope' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(s) -> {
              scope = s
              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else if arg == '--status' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(s) -> {
              status = s
              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else if arg == '--limit' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(l) -> {
              match int_parse(l) {
                case Some(v) -> limit = v
                case None -> {}
              }

              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else {
          i = i + 1
        }
      }
      case Error(_) -> i = i + 1
    }
  }

  if scope != '' {
    if !validate_scope(scope) { return Option.None }
  }

  if status != '' and !validate_status(status) { return Option.None }

  Option.Some(Command.Db(DbCommand.List(scope, status, limit)))
}

fn parse_forget(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  match args.get(1) {
    case Ok(id_str) -> {
      match int_parse(id_str) {
        case Some(id) -> Option.Some(Command.Db(DbCommand.Forget(id)))
        case None -> Option.None
      }
    }
    case Error(_) -> Option.None
  }
}

fn parse_pin(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  match args.get(1) {
    case Ok(id_str) -> {
      match int_parse(id_str) {
        case Some(id) -> Option.Some(Command.Db(DbCommand.Pin(id)))
        case None -> Option.None
      }
    }
    case Error(_) -> Option.None
  }
}

fn parse_unpin(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  match args.get(1) {
    case Ok(id_str) -> {
      match int_parse(id_str) {
        case Some(id) -> Option.Some(Command.Db(DbCommand.Unpin(id)))
        case None -> Option.None
      }
    }
    case Error(_) -> Option.None
  }
}

fn parse_feedback(args: Array[String]) -> Option[Command] {
  if args.size < 3 { return Option.None }

  let id = match args.get(1) {
    case Ok(id_str) -> {
      match int_parse(id_str) {
        case Some(i) -> i
        case None -> return Option.None
      }
    }
    case Error(_) -> return Option.None
  }

  let feedback_type = match args.get(2) {
    case Ok(t) -> t
    case Error(_) -> return Option.None
  }

  if !validate_feedback_type(feedback_type) { return Option.None }

  Option.Some(Command.Db(DbCommand.Feedback(id, feedback_type)))
}

fn parse_maintain(args: Array[String]) -> Option[Command] {
  let mut dry_run = false

  let mut i = 1

  while i < args.size {
    match args.get(i) {
      case Ok(arg) -> if arg == '--dry-run' { dry_run = true }
      case Error(_) -> {}
    }

    i = i + 1
  }

  Option.Some(Command.Db(DbCommand.Maintain(dry_run)))
}

fn parse_agents_md(args: Array[String]) -> Option[Command] {
  let mut path = '.'

  let mut i = 1

  while i < args.size {
    match args.get(i) {
      case Ok(arg) -> {
        if arg == '--path' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(p) -> {
              path = p
              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else {
          i = i + 1
        }
      }
      case Error(_) -> i = i + 1
    }
  }

  Option.Some(Command.Db(DbCommand.AgentsMd(path)))
}

fn parse_import(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  match args.get(1) {
    case Ok(file) -> Option.Some(Command.Db(DbCommand.Import(file)))
    case Error(_) -> Option.None
  }
}

fn parse_hook(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  match args.get(1) {
    case Ok(sub) -> {
      match sub {
        case 'post-compact' -> Option.Some(Command.HookPostCompact)
        case 'install' -> Option.Some(Command.HookInstall)
        case _ -> Option.None
      }
    }
    case Error(_) -> Option.None
  }
}

fn int_parse(s: String) -> Option[Int] {
  let mut result: Int = 0
  let mut valid = false
  let mut negative = false
  let bytes = s.to_byte_array
  let mut i = 0

  # Check for leading minus sign
  if bytes.size > 0 {
    match bytes.get(0) {
      case Ok(b) if b == 45 -> {
        negative = true
        i = 1
      }
      case _ -> {}
    }
  }

  while i < bytes.size {
    match bytes.get(i) {
      case Ok(byte) -> {
        if byte >= 48 and byte <= 57 {
          let digit = byte - 48

          # Check for overflow before computing result * 10 + digit
          # Int.MAX = 9223372036854775807, Int.MIN = -9223372036854775808
          if negative {
            # For negative numbers, Int.MIN (-9223372036854775808) is the limit
            # Special case: when result == 922337203685477580 and digit == 8,
            # we'd compute 9223372036854775808 which overflows Int.MAX.
            # Return Int.MIN directly in this case.
            if result == 922337203685477580 and digit == 8 {
              # Ensure this is the last digit
              if i + 1 == bytes.size {
                return Option.Some(-9223372036854775808)
              } else {
                return Option.None
              }
            }
            if result > 922337203685477580 {
              return Option.None
            }
            if result == 922337203685477580 and digit > 8 {
              return Option.None
            }
          } else {
            # For positive numbers, Int.MAX (9223372036854775807) is the limit
            if result > 922337203685477580 {
              return Option.None
            }
            if result == 922337203685477580 and digit > 7 {
              return Option.None
            }
          }

          valid = true
          result = result * 10 + digit
        } else {
          return Option.None
        }
      }
      case Error(_) -> return Option.None
    }

    i = i + 1
  }

  if valid {
    if negative {
      Option.Some(0 - result)
    } else {
      Option.Some(result)
    }
  } else {
    Option.None
  }
}

fn parse_update(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  let id = match args.get(1) {
    case Ok(id_str) -> {
      match int_parse(id_str) {
        case Some(i) -> i
        case None -> return Option.None
      }
    }
    case Error(_) -> return Option.None
  }

  # Support both positional content and --content flag
  let mut content = ''
  let mut tags = ''
  let mut scope = ''
  let mut positional_content = ''

  # Check if arg 2 is a flag or positional content
  match args.get(2) {
    case Ok(arg) -> {
      if arg == '--content' or arg == '--tags' or arg == '--scope' {
        # It's a flag, no positional content
      } else {
        positional_content = arg
      }
    }
    case Error(_) -> {}
  }

  let mut i = if positional_content != '' { 3 } else { 2 }

  while i < args.size {
    match args.get(i) {
      case Ok(arg) -> {
        if arg == '--content' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(c) -> {
              content = c
              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else if arg == '--tags' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(t) -> {
              tags = t
              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else if arg == '--scope' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(s) -> {
              scope = s
              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else {
          i = i + 1
        }
      }
      case Error(_) -> i = i + 1
    }
  }

  # --content flag takes priority over positional content
  let final_content = if content != '' { content } else { positional_content }

  # Need at least content to update
  if final_content == '' and tags == '' and scope == '' { return Option.None }

  if scope != '' {
    if !validate_scope(scope) { return Option.None }
  }

  Option.Some(Command.Db(DbCommand.Update(id, final_content, tags, scope)))
}

fn parse_history(args: Array[String]) -> Option[Command] {
  if args.size < 2 { return Option.None }

  match args.get(1) {
    case Ok(id_str) -> {
      match int_parse(id_str) {
        case Some(id) -> Option.Some(Command.Db(DbCommand.History(id)))
        case None -> Option.None
      }
    }
    case Error(_) -> Option.None
  }
}

fn parse_contradictions(args: Array[String]) -> Option[Command] {
  let mut resolve_id: Option[Int] = Option.None

  let mut i = 1

  while i < args.size {
    match args.get(i) {
      case Ok(arg) -> {
        if arg == '--resolve' and i + 1 < args.size {
          match args.get(i + 1) {
            case Ok(id_str) -> {
              match int_parse(id_str) {
                case Some(id) -> resolve_id = Option.Some(id)
                case None -> return Option.None
              }

              i = i + 2
            }
            case Error(_) -> i = i + 1
          }
        } else {
          i = i + 1
        }
      }
      case Error(_) -> i = i + 1
    }
  }

  Option.Some(Command.Db(DbCommand.Contradictions(resolve_id)))
}
