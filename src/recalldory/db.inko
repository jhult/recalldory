import extern "sqlite3"

# SQLite constants
let pub SQLITE_OK = 0
let pub SQLITE_ROW = 100
let pub SQLITE_DONE = 101
let pub SQLITE_NULL = 5
let pub SQLITE_TRANSIENT = -1

type pub Database {
  let mut @handle: Pointer[UInt8]
  let @path: String
}

type pub Statement {
  let mut @handle: Pointer[UInt8]
}

# External SQLite functions
fn extern sqlite3_open(filename: Pointer[UInt8], db: Pointer[UInt8]) -> Int32

fn extern sqlite3_close(db: Pointer[UInt8]) -> Int32

fn extern sqlite3_exec(
  db: Pointer[UInt8],
  sql: Pointer[UInt8],
  callback: Pointer[UInt8],
  arg: Pointer[UInt8],
  errmsg: Pointer[UInt8],
) -> Int32

fn extern sqlite3_prepare_v2(
  db: Pointer[UInt8],
  sql: Pointer[UInt8],
  nbyte: Int32,
  stmt: Pointer[UInt8],
  tail: Pointer[UInt8],
) -> Int32

fn extern sqlite3_step(stmt: Pointer[UInt8]) -> Int32

fn extern sqlite3_finalize(stmt: Pointer[UInt8]) -> Int32

fn extern sqlite3_reset(stmt: Pointer[UInt8]) -> Int32

fn extern sqlite3_column_count(stmt: Pointer[UInt8]) -> Int32

fn extern sqlite3_column_type(stmt: Pointer[UInt8], col: Int32) -> Int32

fn extern sqlite3_column_text(
  stmt: Pointer[UInt8],
  col: Int32,
) -> Pointer[UInt8]

fn extern sqlite3_column_int(stmt: Pointer[UInt8], col: Int32) -> Int32

fn extern sqlite3_column_double(stmt: Pointer[UInt8], col: Int32) -> Float64

fn extern sqlite3_column_bytes(stmt: Pointer[UInt8], col: Int32) -> Int32

fn extern sqlite3_column_blob(
  stmt: Pointer[UInt8],
  col: Int32,
) -> Pointer[UInt8]

fn extern sqlite3_bind_text(
  stmt: Pointer[UInt8],
  idx: Int32,
  val: Pointer[UInt8],
  n: Int32,
  destructor: Int64,
) -> Int32

fn extern sqlite3_bind_int(
  stmt: Pointer[UInt8],
  idx: Int32,
  val: Int32,
) -> Int32

fn extern sqlite3_bind_int64(
  stmt: Pointer[UInt8],
  idx: Int32,
  val: Int64,
) -> Int32

fn extern sqlite3_bind_double(
  stmt: Pointer[UInt8],
  idx: Int32,
  val: Float64,
) -> Int32

fn extern sqlite3_bind_null(stmt: Pointer[UInt8], idx: Int32) -> Int32

fn extern sqlite3_bind_blob(
  stmt: Pointer[UInt8],
  idx: Int32,
  val: Pointer[UInt8],
  n: Int32,
  destructor: Int64,
) -> Int32

fn extern sqlite3_errmsg(db: Pointer[UInt8]) -> Pointer[UInt8]

fn extern sqlite3_last_insert_rowid(db: Pointer[UInt8]) -> Int64

fn extern sqlite3_changes(db: Pointer[UInt8]) -> Int32

fn extern sqlite3_enable_load_extension(
  db: Pointer[UInt8],
  onoff: Int32,
) -> Int32

fn extern sqlite3_load_extension(
  db: Pointer[UInt8],
  file: Pointer[UInt8],
  proc: Pointer[UInt8],
  errmsg: Pointer[UInt8],
) -> Int32

fn extern sqlite3_free(ptr: Pointer[UInt8])

# External C functions for memory management
fn extern malloc(size: UInt64) -> Pointer[UInt8]

fn extern free(ptr: Pointer[UInt8])

fn extern memcpy(
  dst: Pointer[UInt8],
  src: Pointer[UInt8],
  n: UInt64,
) -> Pointer[UInt8]

impl Database {
  fn pub static new(path: String) -> Result[Database, String] {
    # Allocate 8 bytes for the output pointer (64-bit)
    let db_ptr_addr = malloc(8 as UInt64)

    let path_bytes = to_cstr(path)
    let result = sqlite3_open(path_bytes.pointer, db_ptr_addr)

    if (result as Int) != 0 {
      let db_ptr = (db_ptr_addr as Pointer[Int64]).0 as Pointer[UInt8]
      let errmsg = sqlite3_errmsg(db_ptr)
      let err_str = pointer_to_string(errmsg)

      sqlite3_close(db_ptr)
      free(db_ptr_addr)
      return Result.Error('Failed to open database: ${err_str}')
    }

    # Read the pointer value from the allocated memory
    let db_ptr = (db_ptr_addr as Pointer[Int64]).0 as Pointer[UInt8]

    free(db_ptr_addr)

    let db = Database(handle: db_ptr, path: path)

    # Set busy timeout so SQLite retries automatically on lock contention
    let _ = db.exec('PRAGMA busy_timeout = 5000')

    Result.Ok(db)
  }

  fn pub mut close {
    if @handle as Int != 0 {
      let result = sqlite3_close(@handle)

      if (result as Int) == 0 { @handle = 0 as Pointer[UInt8] }
    }
  }

  fn pub mut exec(sql: String) -> Result[Nil, String] {
    if @handle as Int == 0 { return Result.Error('Database not open') }

    let sql_bytes = to_cstr(sql)
    let result = sqlite3_exec(
      @handle,
      sql_bytes.pointer,
      0 as Pointer[UInt8],
      0 as Pointer[UInt8],
      0 as Pointer[UInt8],
    )

    if (result as Int) != 0 {
      let errmsg = sqlite3_errmsg(@handle)

      return Result.Error('SQL error: ${pointer_to_string(errmsg)}')
    }

    Result.Ok(nil)
  }

  fn pub mut prepare(sql: String) -> Result[Statement, String] {
    if @handle as Int == 0 { return Result.Error('Database not open') }

    let sql_bytes = to_cstr(sql)
    let stmt_ptr_addr = malloc(8 as UInt64)

    let result = sqlite3_prepare_v2(
      @handle,
      sql_bytes.pointer,
      (sql_bytes.size as Int32),
      stmt_ptr_addr,
      0 as Pointer[UInt8],
    )

    if (result as Int) != 0 {
      let errmsg = sqlite3_errmsg(@handle)

      free(stmt_ptr_addr)
      return Result.Error('Prepare error: ${pointer_to_string(errmsg)}')
    }

    let stmt_ptr = (stmt_ptr_addr as Pointer[Int64]).0 as Pointer[UInt8]

    free(stmt_ptr_addr)

    Result.Ok(Statement(handle: stmt_ptr))
  }

  fn pub mut last_insert_rowid -> Int64 {
    sqlite3_last_insert_rowid(@handle)
  }

  fn pub mut changes -> Int {
    sqlite3_changes(@handle) as Int
  }

  fn mut enable_load_extension(enable: Bool) -> Result[Nil, String] {
    let onoff = if enable { 1 } else { 0 }
    let result = sqlite3_enable_load_extension(@handle, onoff as Int32)

    if (result as Int) != 0 {
      return Result.Error('Failed to enable extension loading')
    }

    Result.Ok(nil)
  }

  fn mut load_extension(path: String) -> Result[Nil, String] {
    let path_bytes = to_cstr(path)
    let errmsg_addr = malloc(8 as UInt64)

    let result = sqlite3_load_extension(
      @handle,
      path_bytes.pointer,
      0 as Pointer[UInt8],
      errmsg_addr,
    )

    if (result as Int) != 0 {
      let errmsg = (errmsg_addr as Pointer[Int64]).0 as Pointer[UInt8]
      let err_str = pointer_to_string(errmsg)

      sqlite3_free(errmsg)
      free(errmsg_addr)
      return Result.Error('Failed to load extension: ${err_str}')
    }

    free(errmsg_addr)
    Result.Ok(nil)
  }
}

impl Statement {
  fn pub mut step -> Int {
    sqlite3_step(@handle) as Int
  }

  fn pub mut reset -> Result[Nil, String] {
    let result = sqlite3_reset(@handle)

    if (result as Int) != 0 { return Result.Error('Reset failed') }

    Result.Ok(nil)
  }

  fn pub mut finalize {
    if @handle as Int != 0 {
      sqlite3_finalize(@handle)
      @handle = 0 as Pointer[UInt8]
    }
  }

  fn pub column_count -> Int {
    sqlite3_column_count(@handle) as Int
  }

  fn pub column_type(col: Int) -> Int {
    sqlite3_column_type(@handle, col as Int32) as Int
  }

  fn pub column_text(col: Int) -> String {
    let ptr = sqlite3_column_text(@handle, col as Int32)

    pointer_to_string(ptr)
  }

  fn pub column_text_nullable(col: Int) -> Option[String] {
    if sqlite3_column_type(@handle, col as Int32) as Int == SQLITE_NULL {
      return Option.None
    }

    let ptr = sqlite3_column_text(@handle, col as Int32)

    Option.Some(pointer_to_string(ptr))
  }

  fn pub column_int(col: Int) -> Int {
    sqlite3_column_int(@handle, col as Int32) as Int
  }

  fn pub column_double(col: Int) -> Float64 {
    sqlite3_column_double(@handle, col as Int32)
  }

  fn pub column_blob(col: Int) -> ByteArray {
    let ptr = sqlite3_column_blob(@handle, col as Int32)
    let len = sqlite3_column_bytes(@handle, col as Int32) as Int

    if len == 0 or ptr as Int == 0 { return ByteArray.new }

    let mut result = ByteArray.filled(with: 0, times: len)
    let _ = memcpy(result.pointer, ptr, len as UInt64)

    result
  }

  fn pub mut bind_text(idx: Int, value: String) -> Result[Nil, String] {
    let bytes = value.to_byte_array
    let result = sqlite3_bind_text(
      @handle,
      idx as Int32,
      bytes.pointer,
      (bytes.size as Int32),
      SQLITE_TRANSIENT as Int64,
    )

    if (result as Int) != 0 { return Result.Error('Bind text failed') }

    Result.Ok(nil)
  }

  fn pub mut bind_int(idx: Int, value: Int) -> Result[Nil, String] {
    let result = sqlite3_bind_int(@handle, idx as Int32, value as Int32)

    if (result as Int) != 0 { return Result.Error('Bind int failed') }

    Result.Ok(nil)
  }

  fn pub mut bind_int64(idx: Int, value: Int64) -> Result[Nil, String] {
    let result = sqlite3_bind_int64(@handle, idx as Int32, value)

    if (result as Int) != 0 { return Result.Error('Bind int64 failed') }

    Result.Ok(nil)
  }

  fn pub mut bind_double(idx: Int, value: Float64) -> Result[Nil, String] {
    let result = sqlite3_bind_double(@handle, idx as Int32, value)

    if (result as Int) != 0 { return Result.Error('Bind double failed') }

    Result.Ok(nil)
  }

  fn pub mut bind_null(idx: Int) -> Result[Nil, String] {
    let result = sqlite3_bind_null(@handle, idx as Int32)

    if (result as Int) != 0 { return Result.Error('Bind null failed') }

    Result.Ok(nil)
  }

  fn pub mut bind_blob(idx: Int, value: ByteArray) -> Result[Nil, String] {
    let result = sqlite3_bind_blob(
      @handle,
      idx as Int32,
      value.pointer,
      (value.size as Int32),
      SQLITE_TRANSIENT as Int64,
    )

    if (result as Int) != 0 { return Result.Error('Bind blob failed') }

    Result.Ok(nil)
  }
}

# Converts a String to a null-terminated byte array for C FFI.
fn pub to_cstr(s: ref String) -> ByteArray {
  let mut bytes = s.to_byte_array

  bytes.push(0)
  bytes
}

# Check if an FTS5 CREATE TABLE SQL string contains the content= option
fn fts_sql_has_content_option(sql: String) -> Bool {
  sql.contains?('content=')
}

fn pointer_to_string(ptr: Pointer[UInt8]) -> String {
  if ptr as Int == 0 { return '' }

  String.from_pointer(ptr)
}

fn pub init_schema(db: mut Database) -> Result[Nil, String] {
  let schema = "
    -- Core memory table
    CREATE TABLE IF NOT EXISTS memories (
      id            INTEGER PRIMARY KEY AUTOINCREMENT,
      content       TEXT NOT NULL,
      content_hash  TEXT NOT NULL,
      summary       TEXT,
      tags          TEXT DEFAULT '[]',
      scope         TEXT DEFAULT 'project',
      status        TEXT DEFAULT 'active',
      is_negative   INTEGER DEFAULT 0,

      strength      REAL DEFAULT 0.5,
      access_count  INTEGER DEFAULT 0,
      decay_rate    REAL DEFAULT 0.01,

      helpful_count INTEGER DEFAULT 0,
      harmful_count INTEGER DEFAULT 0,

      created_at    TEXT NOT NULL DEFAULT (datetime('now')),
      updated_at    TEXT NOT NULL DEFAULT (datetime('now')),
      last_accessed TEXT NOT NULL DEFAULT (datetime('now')),

      -- SimHash for near-duplicate detection (64-bit as hex string)
      simhash       TEXT,

      -- Dual-strength decay
      storage_strength   REAL DEFAULT 0.1,
      retrieval_strength REAL DEFAULT 1.0,

      -- Version chains
      parent_id     INTEGER REFERENCES memories(id),

      -- Contradiction tracking
      is_contradiction INTEGER DEFAULT 0,
      contradicts_id   INTEGER REFERENCES memories(id),

      UNIQUE(content_hash)
    );

    -- Content-synced FTS5 for keyword search
    -- NOTE: Triggers are created by migrate_fts() to handle both new
    -- and existing databases correctly (avoids creating triggers on
    -- standalone FTS tables during migration).
    CREATE VIRTUAL TABLE IF NOT EXISTS memories_fts USING fts5(
      content,
      tags,
      summary,
      content=memories,
      content_rowid=id
    );

    -- Indexes
    CREATE INDEX IF NOT EXISTS idx_memories_status ON memories(status);
    CREATE INDEX IF NOT EXISTS idx_memories_scope ON memories(scope);
    CREATE INDEX IF NOT EXISTS idx_memories_last_accessed ON memories(last_accessed);
    CREATE INDEX IF NOT EXISTS idx_memories_strength ON memories(strength);
    CREATE INDEX IF NOT EXISTS idx_memories_simhash ON memories(simhash);
    CREATE INDEX IF NOT EXISTS idx_memories_parent_id ON memories(parent_id);
  "

  db.exec(schema)
}

# Migrate existing databases to add new columns
# SQLite doesn't support IF NOT EXISTS for ALTER TABLE, so we try and ignore errors
fn pub migrate_schema(db: mut Database) -> Result[Nil, String] {
  # Try to add new columns (ignore errors if columns already exist)
  let migrations = [
    'ALTER TABLE memories ADD COLUMN simhash TEXT',
    'ALTER TABLE memories ADD COLUMN storage_strength REAL DEFAULT 0.1',
    'ALTER TABLE memories ADD COLUMN retrieval_strength REAL DEFAULT 1.0',
    'ALTER TABLE memories ADD COLUMN parent_id INTEGER REFERENCES memories(id)',
    'ALTER TABLE memories ADD COLUMN is_contradiction INTEGER DEFAULT 0',
    'ALTER TABLE memories ADD COLUMN contradicts_id INTEGER REFERENCES memories(id)',
  ]

  for sql in migrations.iter {
    # Try the migration - ignore errors (column already exists)
    let _ = db.exec(sql)
  }

  # Try to add indexes (ignore errors if already exist)
  let indexes = [
    'CREATE INDEX IF NOT EXISTS idx_memories_simhash ON memories(simhash)',
    'CREATE INDEX IF NOT EXISTS idx_memories_parent_id ON memories(parent_id)',
  ]

  for sql in indexes.iter { let _ = db.exec(sql) }

  # Data migration: set storage_strength from strength (scale 0-1 to 0-10)
  # and set retrieval_strength to 0.5 as neutral starting point.
  # Use schema_version table to ensure this runs exactly once.
  let _ = db.exec(
    'CREATE TABLE IF NOT EXISTS schema_version (key TEXT PRIMARY KEY, value INTEGER NOT NULL)',
  )
  let mut version_stmt = match
    db.prepare(
      "SELECT value FROM schema_version WHERE key = 'strength_migration'",
    )
  {
    case Ok(s) -> s
    case Error(_) -> return Result.Error('Failed to check schema version')
  }
  let already_migrated = if version_stmt.step == SQLITE_ROW {
    version_stmt.column_int(0) == 1
  } else {
    false
  }

  version_stmt.finalize

  if !already_migrated {
    let _ = db.exec(
      'UPDATE memories SET storage_strength = strength * 10, retrieval_strength = 0.5 WHERE storage_strength = 0.1',
    )
    let _ = db.exec(
      "INSERT OR IGNORE INTO schema_version (key, value) VALUES ('strength_migration', 1)",
    )
  }

  # Migrate standalone FTS5 to content-synced FTS5 if needed
  match migrate_fts(db) {
    case Error(e) -> return Result.Error(e)
    case Ok(_) -> {}
  }

  Result.Ok(nil)
}

# Ensure content-synced FTS5 with triggers is set up.
# For new databases: creates triggers for the content-synced FTS table.
# For existing databases: detects standalone FTS, drops it, recreates
# as content-synced, adds triggers, and rebuilds the index.
fn pub migrate_fts(db: mut Database) -> Result[Nil, String] {
  # Check if all 3 sync triggers already exist (fully migrated)
  let check_sql = "SELECT COUNT(*) FROM sqlite_master WHERE type='trigger' AND name IN ('memories_fts_ai', 'memories_fts_ad', 'memories_fts_au')"
  let mut check_stmt = match db.prepare(check_sql) {
    case Ok(s) -> s
    case Error(_) -> return Result.Ok(nil)
  }

  let trigger_count = if check_stmt.step == SQLITE_ROW {
    check_stmt.column_int(0)
  } else {
    0
  }

  check_stmt.finalize

  if trigger_count == 3 { return Result.Ok(nil) }

  # Check if the existing FTS table is standalone (not content-synced).
  # If standalone, we must drop and recreate it.
  let fts_check_sql = "SELECT sql FROM sqlite_master WHERE type='table' AND name='memories_fts'"
  let mut fts_stmt = match db.prepare(fts_check_sql) {
    case Ok(s) -> s
    case Error(_) -> return Result.Ok(nil)
  }

  let mut need_recreate = false

  if fts_stmt.step == SQLITE_ROW {
    let fts_sql = fts_stmt.column_text(0)
    # Standalone FTS tables don't have content= in their definition.
    # Simple check: content-synced FTS SQL contains "content="
    if !fts_sql_has_content_option(fts_sql) { need_recreate = true }
  }

  fts_stmt.finalize

  if need_recreate {
    # Drop any partial triggers from a broken migration
    let _ = db.exec('DROP TRIGGER IF EXISTS memories_fts_ai')
    let _ = db.exec('DROP TRIGGER IF EXISTS memories_fts_ad')
    let _ = db.exec('DROP TRIGGER IF EXISTS memories_fts_au')

    # Drop old standalone FTS table and recreate as content-synced
    let _ = db.exec('DROP TABLE IF EXISTS memories_fts')

    match
      db.exec(
        'CREATE VIRTUAL TABLE IF NOT EXISTS memories_fts USING fts5(content, tags, summary, content=memories, content_rowid=id)',
      )
    {
      case Error(e) -> return Result.Error('Failed to create FTS table: ${e}')
      case Ok(_) -> {}
    }
  }

  # Create sync triggers (idempotent with IF NOT EXISTS)
  match
    db.exec(
      "CREATE TRIGGER IF NOT EXISTS memories_fts_ai AFTER INSERT ON memories BEGIN INSERT INTO memories_fts(rowid, content, tags, summary) VALUES (new.id, new.content, new.tags, COALESCE(new.summary, '')); END",
    )
  {
    case Error(e) -> return Result.Error('Failed to create trigger: ${e}')
    case Ok(_) -> {}
  }

  match
    db.exec(
      "CREATE TRIGGER IF NOT EXISTS memories_fts_ad AFTER DELETE ON memories BEGIN INSERT INTO memories_fts(memories_fts, rowid, content, tags, summary) VALUES('delete', old.id, old.content, old.tags, COALESCE(old.summary, '')); END",
    )
  {
    case Error(e) -> return Result.Error('Failed to create trigger: ${e}')
    case Ok(_) -> {}
  }

  match
    db.exec(
      "CREATE TRIGGER IF NOT EXISTS memories_fts_au AFTER UPDATE ON memories BEGIN INSERT INTO memories_fts(memories_fts, rowid, content, tags, summary) VALUES('delete', old.id, old.content, old.tags, COALESCE(old.summary, '')); INSERT INTO memories_fts(rowid, content, tags, summary) VALUES (new.id, new.content, new.tags, COALESCE(new.summary, '')); END",
    )
  {
    case Error(e) -> return Result.Error('Failed to create trigger: ${e}')
    case Ok(_) -> {}
  }

  # Rebuild FTS index if we recreated the table
  if need_recreate {
    match db.exec("INSERT INTO memories_fts(memories_fts) VALUES('rebuild')") {
      case Error(e) -> return Result.Error('Failed to rebuild FTS: ${e}')
      case Ok(_) -> {}
    }
  }

  Result.Ok(nil)
}
