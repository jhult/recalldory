import std.bytes (ByteArray)
import std.map (Map)

# Common words to ignore for entity extraction
let pub COMMON_WORDS = [
  'the',
  'that',
  'this',
  'with',
  'from',
  'have',
  'been',
  'were',
  'what',
  'when',
  'where',
  'which',
  'while',
  'about',
  'would',
  'could',
  'should',
  'their',
  'there',
  'these',
  'those',
  'being',
]

# Negation words for contradiction detection
let pub NEGATION_WORDS = [
  'not',
  'never',
  'dont',
  'avoid',
  'cannot',
  'neither',
  'nobody',
  'nothing',
  'nowhere',
  'none',
  'without',
  'cant',
  'wont',
  'shouldnt',
  'isnt',
  'couldnt',
  'wouldnt',
  'hasnt',
  'havent',
  'arent',
  'doesnt',
  'didnt',
  'wasnt',
  'werent',
]

# Convert an ASCII string to lowercase.
fn pub to_lowercase(s: String) -> String {
  let bytes = s.to_byte_array
  let mut result = ByteArray.new

  for byte in bytes.iter {
    if byte >= 65 and byte <= 90 {
      # Convert uppercase to lowercase by adding 32 to ASCII value
      result.push(byte + 32)
    } else {
      result.push(byte)
    }
  }

  result.into_string
}

# Extract significant words (longer than 3 chars, not common words) from text bytes.
fn pub extract_entities(bytes: ref ByteArray) -> Array[String] {
  let mut entities: Array[String] = []
  let mut word_bytes: ByteArray = ByteArray.new
  let mut in_word = false

  for byte in bytes.iter {
    # ASCII alphanumeric OR any byte >= 128 (UTF-8 multi-byte continuation)
    let is_alphanum = (byte >= 48 and byte <= 57)
      or (byte >= 65 and byte <= 90)
      or (byte >= 97 and byte <= 122)
      or (byte >= 128)

    if is_alphanum {
      word_bytes.push(byte)
      in_word = true
    } else if in_word {
      if word_bytes.size > 2 {
        let word_str = word_bytes.clone.into_string
        let mut is_common = false

        for common in COMMON_WORDS.iter {
          if word_str == common {
            is_common = true
            break
          }
        }

        if !is_common { entities.push(word_str) }
      }

      word_bytes = ByteArray.new
      in_word = false
    }
  }

  # Handle last word
  if in_word and word_bytes.size > 2 {
    let word_str = word_bytes.clone.into_string

    let mut is_common = false

    for common in COMMON_WORDS.iter {
      if word_str == common { is_common = true }
    }

    if !is_common { entities.push(word_str) }
  }

  entities
}

# Check if the text contains any negation words (e.g. "not", "never", "avoid").
fn pub has_negation_words(bytes: ref ByteArray) -> Bool {
  let mut word_bytes: ByteArray = ByteArray.new
  let mut in_word = false

  for byte in bytes.iter {
    # ASCII alphanumeric OR any byte >= 128 (UTF-8 multi-byte continuation)
    let is_alphanum = (byte >= 48 and byte <= 57)
      or (byte >= 65 and byte <= 90)
      or (byte >= 97 and byte <= 122)
      or (byte >= 128)

    if is_alphanum {
      word_bytes.push(byte)
      in_word = true
    } else if in_word {
      let word_str = word_bytes.clone.into_string

      for neg in NEGATION_WORDS.iter {
        if word_str == neg { return true }
      }

      word_bytes = ByteArray.new
      in_word = false
    }
  }

  if in_word {
    let word_str = word_bytes.clone.into_string

    for neg in NEGATION_WORDS.iter {
      if word_str == neg { return true }
    }
  }

  false
}

# Count how many entities appear in both arrays (deduplicated).
fn pub count_entity_overlap(
  entities1: ref Array[String],
  entities2: ref Array[String],
) -> Int {
  let mut count = 0
  let mut matched: Map[String, Bool] = Map.new

  for e1 in entities1.iter {
    for e2 in entities2.iter {
      if e1 == e2 {
        match matched.get(e2) {
          case Ok(_) -> {} # already counted
          case Error(_) -> {
            matched.set(e2, true)
            count = count + 1
          }
        }

        break
      }
    }
  }

  count
}

# Sanitize a string for use in FTS5 MATCH queries.
# Returns the query with double quotes escaped by doubling.
# Does NOT wrap in outer quotes - use token search for general queries.
#
# NOTE: This function does NOT strip FTS5 query syntax. Users can use
# advanced features like prefix matching (term*), NEAR, AND, OR, NOT,
# and column qualifiers. This is intentional for power users but may
# result in unexpected matches or performance for untrusted input.
fn pub sanitize_fts5_query(query: String) -> String {
  let bytes = query.to_byte_array
  let mut result = ByteArray.new

  for byte in bytes.iter {
    # Escape double quotes by doubling them
    if byte == 34 {
      result.push(34)
      result.push(34)
    } else if byte == 40 or byte == 41 {
      # ( )
      # Replace parentheses with spaces to avoid FTS5 syntax errors
      result.push(32)
    } else if byte < 32 or byte == 127 {
      # Control characters - just remove them
    } else {
      result.push(byte)
    }
  }

  result.into_string
}

# Return the UTF-8 sequence length for a leading byte.
fn utf8_length(lead: Int) -> Int {
  if lead < 194 {
    1
  } else if lead < 224 {
    2
  } else if lead < 240 {
    3
  } else {
    4
  }
}

# Return the byte at `i`, or 0 when out of bounds.
fn byte_at(bytes: ref ByteArray, i: Int) -> Int {
  if i < 0 or i >= bytes.size { return 0 }

  match bytes.get(i) {
    case Ok(v) -> v
    case Error(_) -> 0
  }
}

# Decode the UTF-8 code point starting at `i` with the given sequence length.
fn decode_codepoint(bytes: ref ByteArray, i: Int, len: Int) -> Int {
  let b0 = byte_at(bytes, i)

  if len == 2 {
    ((b0 & 31) << 6) + (byte_at(bytes, i + 1) & 63)
  } else if len == 3 {
    ((b0 & 15) << 12)
      + ((byte_at(bytes, i + 1) & 63) << 6)
      + (byte_at(bytes, i + 2) & 63)
  } else if len == 4 {
    ((b0 & 7) << 18)
      + ((byte_at(bytes, i + 1) & 63) << 12)
      + ((byte_at(bytes, i + 2) & 63) << 6)
      + (byte_at(bytes, i + 3) & 63)
  } else {
    b0
  }
}

# Returns true if the code point is invisible or a bidirectional formatting
# character. Such characters are used to smuggle hidden instructions into text
# that is later injected into an LLM's system prompt.
fn is_invisible_codepoint(cp: Int) -> Bool {
  # Soft hyphen
  if cp == 0x00AD { return true }

  # Arabic letter mark
  if cp == 0x061C { return true }

  # Mongolian vowel separator
  if cp == 0x180E { return true }

  # Zero-width space/joiners and directional marks (U+200B-U+200F)
  if cp >= 0x200B and cp <= 0x200F { return true }

  # Bidirectional embedding/override characters (U+202A-U+202E)
  if cp >= 0x202A and cp <= 0x202E { return true }

  # Word joiner and deprecated invisible operators (U+2060-U+206F)
  if cp >= 0x2060 and cp <= 0x206F { return true }

  # Byte order mark / zero-width no-break space
  if cp == 0xFEFF { return true }

  # Interlinear annotation characters
  if cp >= 0xFFF9 and cp <= 0xFFFB { return true }

  # Musical symbol formatting characters
  if cp >= 0x1D173 and cp <= 0x1D17A { return true }

  # Tag characters, abused for hidden prompt-injection payloads
  if cp >= 0xE0000 and cp <= 0xE007F { return true }

  false
}

# Strip invisible and bidirectional Unicode control characters from text. ASCII
# control characters are removed too, except for tab, line feed and carriage
# return. This prevents prompt-injection payloads hidden via zero-width or
# bidirectional characters from being stored and later injected into a system
# prompt by the post-compact hook.
fn pub strip_invisible_unicode(s: String) -> String {
  let bytes = s.to_byte_array
  let size = bytes.size
  let mut result = ByteArray.new
  let mut i = 0

  while i < size {
    let b = byte_at(ref bytes, i)

    if b < 128 {
      # Keep tab, line feed and carriage return; drop other control characters.
      if (b < 32 and b != 9 and b != 10 and b != 13) or b == 127 {
        i = i + 1
      } else {
        result.push(b)
        i = i + 1
      }
    } else {
      let len = utf8_length(b)

      if i + len > size {
        # Truncated sequence at the end: copy the remaining bytes unchanged.
        while i < size {
          result.push(byte_at(ref bytes, i))
          i = i + 1
        }
      } else if is_invisible_codepoint(decode_codepoint(ref bytes, i, len)) {
        i = i + len
      } else {
        let mut k = 0

        while k < len {
          result.push(byte_at(ref bytes, i + k))
          k = k + 1
        }

        i = i + len
      }
    }
  }

  result.into_string
}

# Escape a string for safe embedding in JSON (handles quotes, backslash, control chars).
fn pub escape_json(s: String) -> String {
  let hex_chars = '0123456789abcdef'.to_byte_array
  let bytes = s.to_byte_array
  let mut result = ByteArray.new

  for byte in bytes.iter {
    if byte == 34 {
      result.push(92)
      result.push(34)
    } else if byte == 92 {
      result.push(92)
      result.push(92)
    } else if byte == 10 {
      result.push(92)
      result.push(110)
    } else if byte == 13 {
      result.push(92)
      result.push(114)
    } else if byte == 9 {
      result.push(92)
      result.push(116)
    } else if byte == 8 {
      result.push(92)
      result.push(98)
    } else if byte == 12 {
      result.push(92)
      result.push(102)
    } else if byte < 32 {
      result.push(92) # \
      result.push(117) # u
      result.push(48) # 0
      result.push(48) # 0

      let hi = (byte >> 4) & 15
      let lo = byte & 15

      match hex_chars.get(hi) {
        case Ok(h) -> result.push(h)
        case Error(_) -> result.push(48)
      }

      match hex_chars.get(lo) {
        case Ok(l) -> result.push(l)
        case Error(_) -> result.push(48)
      }
    } else {
      result.push(byte)
    }
  }

  result.into_string
}
