import recalldory.db (Database, init_schema, migrate_schema)
import std.env

# Open (or create) the memory database. If global is true, uses ~/.recalldory/memory.db;
# otherwise uses ./.recalldory/memory.db. Runs schema init and migrations.
fn pub open_database(global: Bool) -> Result[Database, String] {
  let path = if global {
    let home = match env.get('HOME') {
      case Ok(h) -> h
      case Error(_) -> return Result.Error('HOME not set')
    }
    let dir = '${home}/.recalldory'.to_path

    let _ = dir.create_directory
    '${home}/.recalldory/memory.db'
  } else {
    let dir = '.recalldory'.to_path

    let _ = dir.create_directory
    './.recalldory/memory.db'
  }

  let db = match Database.new(path) {
    case Ok(d) -> d
    case Error(e) -> return Result.Error('Failed to open database: ${e}')
  }

  # Enable WAL mode before schema init for better write performance
  match db.exec('PRAGMA journal_mode=WAL') {
    case Error(e) -> {
      db.close
      return Result.Error('Failed to enable WAL mode: ${e}')
    }
    case Ok(_) -> {}
  }

  # Enforce referential integrity for parent_id and contradicts_id FK columns
  match db.exec('PRAGMA foreign_keys = ON') {
    case Error(e) -> {
      db.close
      return Result.Error('Failed to enable foreign keys: ${e}')
    }
    case Ok(_) -> {}
  }

  match init_schema(db) {
    case Error(e) -> {
      db.close
      return Result.Error('Failed to initialize schema: ${e}')
    }
    case Ok(_) -> {}
  }

  # Run migrations for existing databases
  match migrate_schema(db) {
    case Error(e) -> {
      db.close
      return Result.Error('Failed to migrate schema: ${e}')
    }
    case Ok(_) -> {}
  }

  Result.Ok(db)
}
