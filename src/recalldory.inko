import recalldory.cli (DbCommand, parse_args, print_help)
import recalldory.db (Database)
import recalldory.hooks (
  handle_hook_inject, handle_hook_register, handle_hook_unregister,
)
import recalldory.init (handle_init)
import recalldory.memory (
  output_contradictions, output_history, output_memories,
  output_merged_memories,
)
import recalldory.memstore (open_global_database, open_project_database)
import recalldory.memstore_contradiction (
  list_contradictions, resolve_contradiction,
)
import recalldory.memstore_crud (
  add_memory_with_source, feedback_memory, forget_memory, get_history,
  list_memories, pin_memory, search_memories, unpin_memory,
  update_memory_with_source,
)
import recalldory.memstore_import (
  export_memories, generate_agents_md, import_memories,
)
import recalldory.memstore_maintain (get_stats, maintain_memory, rebuild_fts)
import recalldory.report (fail)
import recalldory.text (escape_json)
import std.env
import std.stdio (Stdout)

# Application entry point.
type async Main {
  fn async main {
    let out = Stdout.new

    match parse_args {
      case Ok(parsed) -> {
        let cmd = parsed.into_command

        match cmd {
          case Help -> print_help(out)
          case Version -> print_version(out)
          case HookInject(titles) -> handle_hook_inject(titles, out)
          case HookRegister(titles) -> handle_hook_register(titles, out)
          case HookUnregister -> handle_hook_unregister(out)
          case Init(no_gitignore) -> handle_init(no_gitignore, out)
          case Db(db_cmd) -> run_with_db(db_cmd, out)
        }
      }
      case Error(e) -> fail(e)
    }
  }
}

# Run an operation against the project database, falling back to the global
# database when it returns an error (e.g. the row only exists globally).
fn project_then_global[T](
  operation: fn (mut Database) -> Result[T, String],
) -> Result[T, String] {
  match open_project_database {
    case Ok(db) -> {
      let mut database = db
      let result = operation.call(mut database)

      database.close

      match result {
        case Ok(v) -> Result.Ok(v)
        case Error(_) -> project_then_global_fallback(operation)
      }
    }
    case Error(_) -> project_then_global_fallback(operation)
  }
}

fn project_then_global_fallback[T](
  operation: fn (mut Database) -> Result[T, String],
) -> Result[T, String] {
  match open_global_database {
    case Ok(db) -> {
      let mut database = db
      let result = operation.call(mut database)

      database.close
      result
    }
    case Error(e) -> Result.Error(e)
  }
}

fn run_with_db(cmd: DbCommand, out: Stdout) {
  match cmd {
    case Add(content, tags, scope, pin, source) -> {
      let db_result = if scope == 'global' {
        open_global_database
      } else {
        open_project_database
      }

      match db_result {
        case Ok(db) -> {
          let mut database = db

          match
            add_memory_with_source(database, content, tags, scope, pin, source)
          {
            case Ok(result) -> {
              let dedup = if result.deduplicated { 'true' } else { 'false' }
              let contra = if result.contradiction { 'true' } else { 'false' }
              let mut json = '{"success": true, "id": ${result.id}, "deduplicated": ${dedup}, "contradiction": ${contra}'

              if result.contradiction {
                json = json
                  + ', "contradicts_count": ${result.contradicts_count}'

                match result.contradicts_id {
                  case Some(cid) -> json = json + ', "contradicts_id": ${cid}'
                  case None -> {}
                }
              }

              json = json + '}'
              out.print(json)
            }
            case Error(e) -> fail(e)
          }

          database.close
        }
        case Error(e) -> fail(e)
      }
    }
    case Recall(query, scope, top) -> recall_both_dbs(query, scope, top, out)
    case List(scope, status, limit, older_than) -> {
      list_both_dbs(scope, status, limit, older_than, out)
    }
    case Forget(id) -> {
      match project_then_global(fn (db) { forget_memory(db, id) }) {
        case Ok(deleted) -> out.print('{"success": ${deleted}}')
        case Error(e) -> fail(e)
      }
    }
    case Pin(id) -> {
      match project_then_global(fn (db) { pin_memory(db, id) }) {
        case Ok(pinned) -> out.print('{"success": ${pinned}}')
        case Error(e) -> fail(e)
      }
    }
    case Unpin(id) -> {
      match project_then_global(fn (db) { unpin_memory(db, id) }) {
        case Ok(unpinned) -> out.print('{"success": ${unpinned}}')
        case Error(e) -> fail(e)
      }
    }
    case Feedback(id, feedback_type) -> {
      match
        project_then_global(fn (db) { feedback_memory(db, id, feedback_type) })
      {
        case Ok(updated) -> out.print('{"success": ${updated}}')
        case Error(e) -> fail(e)
      }
    }
    case Maintain(dry_run) -> maintain_both_dbs(dry_run, out)
    case Export -> {
      match open_project_database {
        case Ok(db) -> {
          let mut database = db

          match export_memories(database) {
            case Ok(json) -> out.print(json)
            case Error(e) -> fail(e)
          }

          database.close
        }
        case Error(e) -> fail(e)
      }
    }
    case Import(file) -> {
      match open_project_database {
        case Ok(db) -> {
          let mut database = db

          match import_memories(database, file) {
            case Ok(result) -> {
              let mut json = '{"success": true, "imported": ${result.imported}, "failed": ${result.failed}, "deduplicated": ${result.deduplicated}'

              if result.first_error != '' {
                json = json
                  + ', "first_error": "${escape_json(result.first_error)}"'
              }

              json = json + '}'
              out.print(json)
            }
            case Error(e) -> fail(e)
          }

          database.close
        }
        case Error(e) -> fail(e)
      }
    }
    case AgentsMd(path) -> {
      match open_project_database {
        case Ok(db) -> {
          let mut database = db

          match generate_agents_md(database, path) {
            case Ok(_) -> out.print('{"success": true}')
            case Error(e) -> fail(e)
          }

          database.close
        }
        case Error(e) -> fail(e)
      }
    }
    case Stats -> stats_both_dbs(out)
    case Update(id, content, tags, scope, source) -> {
      # Documented behaviour: `update` searches the project database first and
      # falls back to the global database. A supplied `scope` is only the new
      # scope value to write, not a hint about which database to open.
      let mut handled = false

      match open_project_database {
        case Ok(db) -> {
          let mut database = db

          match
            update_memory_with_source(
              database,
              id,
              content,
              tags,
              scope,
              source,
            )
          {
            case Ok(new_id) -> {
              database.close

              let _ = out.print(
                '{"success": true, "new_id": ${new_id}, "old_id": ${id}}',
              )

              handled = true
            }
            case Error(e) -> {
              database.close

              # A genuine error (e.g. content collision) is reported here;
              # "not found" means we should try the global database instead.
              if !e.contains?('not found') { fail(e) }
            }
          }
        }
        case Error(_) -> {}
      }

      if !handled {
        match open_global_database {
          case Ok(db) -> {
            let mut database = db

            match
              update_memory_with_source(
                database,
                id,
                content,
                tags,
                scope,
                source,
              )
            {
              case Ok(new_id) -> {
                database.close
                out.print(
                  '{"success": true, "new_id": ${new_id}, "old_id": ${id}}',
                )
              }
              case Error(e) -> {
                database.close
                fail(e)
              }
            }
          }
          case Error(e) -> fail(e)
        }
      }
    }
    case History(id) -> {
      match project_then_global(fn (db) { get_history(db, id) }) {
        case Ok(result) -> output_history(result, out)
        case Error(e) -> fail(e)
      }
    }
    case Contradictions(resolve_id) -> {
      match open_project_database {
        case Ok(db) -> {
          let mut database = db

          match resolve_id {
            case Some(rid) -> {
              match resolve_contradiction(database, rid) {
                case Ok(resolved) -> {
                  database.close
                  out.print('{"success": ${resolved}, "resolved_id": ${rid}}')
                }
                case Error(e) -> {
                  database.close
                  fail(e)
                }
              }
            }
            case None -> {
              match list_contradictions(database) {
                case Ok(mems) -> {
                  database.close
                  output_contradictions(mems, out)
                }
                case Error(e) -> {
                  database.close
                  fail(e)
                }
              }
            }
          }
        }
        case Error(e) -> fail(e)
      }
    }
    case RebuildFts -> rebuild_fts_both_dbs(out)
  }
}

# Search both project and global databases, merging results.
fn recall_both_dbs(query: String, scope: String, top: Int, out: Stdout) {
  match open_project_database {
    case Ok(project_db) -> {
      let mut pdb = project_db

      match search_memories(pdb, query, scope, top) {
        case Ok(project_mems) -> {
          pdb.close

          match open_global_database {
            case Ok(global_db) -> {
              let mut gDB = global_db

              match search_memories(gDB, query, scope, top) {
                case Ok(global_mems) -> {
                  gDB.close
                  output_merged_memories(project_mems, global_mems, out)
                }
                case Error(_) -> {
                  gDB.close
                  output_memories(project_mems, out)
                }
              }
            }
            case Error(_) -> output_memories(project_mems, out)
          }
        }
        case Error(_) -> {
          pdb.close

          match open_global_database {
            case Ok(global_db) -> {
              let mut gDB = global_db

              match search_memories(gDB, query, scope, top) {
                case Ok(global_mems) -> {
                  gDB.close
                  output_memories(global_mems, out)
                }
                case Error(ge) -> {
                  gDB.close
                  fail(ge)
                }
              }
            }
            case Error(ge) -> fail(ge)
          }
        }
      }
    }
    case Error(_) -> {
      match open_global_database {
        case Ok(global_db) -> {
          let mut gDB = global_db

          match search_memories(gDB, query, scope, top) {
            case Ok(global_mems) -> {
              gDB.close
              output_memories(global_mems, out)
            }
            case Error(ge) -> {
              gDB.close
              fail(ge)
            }
          }
        }
        case Error(pe2) -> fail(pe2)
      }
    }
  }
}

# List from both project and global databases, merging results.
fn list_both_dbs(
  scope: String,
  status: String,
  limit: Int,
  older_than: Option[Int],
  out: Stdout,
) {
  match open_project_database {
    case Ok(project_db) -> {
      let mut pdb = project_db

      match list_memories(pdb, scope, status, limit, older_than) {
        case Ok(project_mems) -> {
          pdb.close

          match open_global_database {
            case Ok(global_db) -> {
              let mut gDB = global_db

              match list_memories(gDB, scope, status, limit, older_than) {
                case Ok(global_mems) -> {
                  gDB.close
                  output_merged_memories(project_mems, global_mems, out)
                }
                case Error(_) -> {
                  gDB.close
                  output_memories(project_mems, out)
                }
              }
            }
            case Error(_) -> output_memories(project_mems, out)
          }
        }
        case Error(_) -> {
          pdb.close

          match open_global_database {
            case Ok(global_db) -> {
              let mut gDB = global_db

              match list_memories(gDB, scope, status, limit, older_than) {
                case Ok(global_mems) -> {
                  gDB.close
                  output_memories(global_mems, out)
                }
                case Error(ge) -> {
                  gDB.close
                  fail(ge)
                }
              }
            }
            case Error(ge) -> fail(ge)
          }
        }
      }
    }
    case Error(_) -> {
      match open_global_database {
        case Ok(global_db) -> {
          let mut gDB = global_db

          match list_memories(gDB, scope, status, limit, older_than) {
            case Ok(global_mems) -> {
              gDB.close
              output_memories(global_mems, out)
            }
            case Error(ge) -> {
              gDB.close
              fail(ge)
            }
          }
        }
        case Error(pe2) -> fail(pe2)
      }
    }
  }
}

# Run maintenance on both databases, combining the results.
fn maintain_both_dbs(dry_run: Bool, out: Stdout) {
  match open_project_database {
    case Ok(db) -> {
      let mut database = db

      match maintain_memory(database, dry_run) {
        case Ok(stats) -> {
          database.close

          let mut total_decayed = stats.decayed
          let mut total_anti = stats.anti_patterns
          let mut total_pruned = stats.pruned

          match open_global_database {
            case Ok(global_db) -> {
              let mut gDB = global_db

              match maintain_memory(gDB, dry_run) {
                case Ok(gStats) -> {
                  gDB.close
                  total_decayed = total_decayed + gStats.decayed
                  total_anti = total_anti + gStats.anti_patterns
                  total_pruned = total_pruned + gStats.pruned
                }
                case Error(_) -> gDB.close
              }
            }
            case Error(_) -> {}
          }

          out.print(
            '{"decayed": ${total_decayed}, "anti_patterns": ${total_anti}, "pruned": ${total_pruned}}',
          )
        }
        case Error(e) -> {
          database.close
          fail(e)
        }
      }
    }
    case Error(e) -> fail(e)
  }
}

# Combine stats from both databases.
fn stats_both_dbs(out: Stdout) {
  match open_project_database {
    case Ok(db) -> {
      let mut database = db

      match get_stats(database) {
        case Ok(stats) -> {
          database.close

          let mut total = stats.total
          let mut active = stats.active
          let mut pinned = stats.pinned
          let mut anti_pattern = stats.anti_pattern
          let mut total_strength = stats.total_strength

          match open_global_database {
            case Ok(global_db) -> {
              let mut gDB = global_db

              match get_stats(gDB) {
                case Ok(gStats) -> {
                  gDB.close
                  total = total + gStats.total
                  active = active + gStats.active
                  pinned = pinned + gStats.pinned
                  anti_pattern = anti_pattern + gStats.anti_pattern
                  total_strength = total_strength + gStats.total_strength
                }
                case Error(_) -> gDB.close
              }
            }
            case Error(_) -> {}
          }

          let avg = if total > 0 {
            total_strength / (total as Float)
          } else {
            0.0
          }

          out.print(
            '{"total": ${total}, "active": ${active}, "pinned": ${pinned}, "anti_pattern": ${anti_pattern}, "avg_strength": ${avg.to_string}}',
          )
        }
        case Error(e) -> {
          database.close
          fail(e)
        }
      }
    }
    case Error(e) -> fail(e)
  }
}

# Rebuild FTS on both databases.
fn rebuild_fts_both_dbs(out: Stdout) {
  match open_project_database {
    case Ok(db) -> {
      let mut database = db

      match rebuild_fts(database) {
        case Ok(count) -> {
          database.close

          match open_global_database {
            case Ok(global_db) -> {
              let mut gDB = global_db

              match rebuild_fts(gDB) {
                case Ok(gCount) -> {
                  gDB.close
                  out.print('{"success": true, "indexed": ${count + gCount}}')
                }
                case Error(_) -> {
                  gDB.close
                  out.print('{"success": true, "indexed": ${count}}')
                }
              }
            }
            case Error(_) -> out.print('{"success": true, "indexed": ${count}}')
          }
        }
        case Error(e) -> {
          database.close
          fail(e)
        }
      }
    }
    case Error(e) -> fail(e)
  }
}

fn print_version(out: Stdout) {
  let version = match env.get('VERSION') {
    case Ok(v) -> v
    case Error(_) -> 'dev'
  }

  out.print('recalldory ${version}')
}
