import recalldory.cli (DbCommand, parse_args, print_help)
import recalldory.db (Database)
import recalldory.hooks (handle_hook_install, handle_hook_post_compact)
import recalldory.memory (
  output_contradictions, output_history, output_memories,
)
import recalldory.memstore (open_database)
import recalldory.memstore_contradiction (
  list_contradictions, resolve_contradiction,
)
import recalldory.memstore_crud (
  add_memory, feedback_memory, forget_memory, get_history, list_memories,
  pin_memory, search_memories, unpin_memory, update_memory,
)
import recalldory.memstore_import (
  export_memories, generate_agents_md, import_memories,
)
import recalldory.memstore_maintain (get_stats, maintain_memory, rebuild_fts)
import recalldory.text (escape_json)
import std.stdio (Stdout)

# Application entry point.
type async Main {
  fn async main {
    let out = Stdout.new

    match parse_args {
      case Some(parsed) -> {
        let db_path = match parsed.db_path {
          case Some(p) -> Option.Some(p)
          case None -> Option.None
        }
        let cmd = parsed.into_command

        match cmd {
          case Help -> print_help(out)
          case HookPostCompact -> handle_hook_post_compact(out)
          case HookInstall -> handle_hook_install(out)
          case Db(db_cmd) -> run_with_db(db_cmd, db_path, out)
        }
      }
      case None -> print_help(out)
    }
  }
}

fn run_with_db(cmd: DbCommand, db_path: Option[String], out: Stdout) {
  match open_database(db_path) {
    case Ok(db) -> {
      let mut database = db

      handle_command(cmd, database, out)
      database.close
    }
    case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
  }
}

fn handle_command(cmd: DbCommand, db: mut Database, out: Stdout) {
  match cmd {
    case Add(content, tags, scope, pin) -> {
      match add_memory(db, content, tags, scope, pin) {
        case Ok(result) -> {
          let dedup = if result.deduplicated { 'true' } else { 'false' }
          let contra = if result.contradiction { 'true' } else { 'false' }
          let mut json = '{"success": true, "id": ${result.id}, "deduplicated": ${dedup}, "contradiction": ${contra}'

          if result.contradiction {
            json = json + ', "contradicts_count": ${result.contradicts_count}'

            match result.contradicts_id {
              case Some(cid) -> json = json + ', "contradicts_id": ${cid}'
              case None -> {}
            }
          }

          json = json + '}'
          out.print(json)
        }
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case Recall(query, scope, top) -> {
      match search_memories(db, query, scope, top) {
        case Ok(mems) -> output_memories(mems, out)
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case List(scope, status, limit, older_than) -> {
      match list_memories(db, scope, status, limit, older_than) {
        case Ok(mems) -> output_memories(mems, out)
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case Forget(id) -> {
      match forget_memory(db, id) {
        case Ok(deleted) -> out.print('{"success": ${deleted}}')
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case Pin(id) -> {
      match pin_memory(db, id) {
        case Ok(pinned) -> out.print('{"success": ${pinned}}')
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case Unpin(id) -> {
      match unpin_memory(db, id) {
        case Ok(unpinned) -> out.print('{"success": ${unpinned}}')
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case Feedback(id, feedback_type) -> {
      match feedback_memory(db, id, feedback_type) {
        case Ok(updated) -> out.print('{"success": ${updated}}')
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case Maintain(dry_run) -> {
      match maintain_memory(db, dry_run) {
        case Ok(stats) -> {
          out.print(
            '{"decayed": ${stats.decayed}, "anti_patterns": ${stats.anti_patterns}, "pruned": ${stats.pruned}}',
          )
        }
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case Export -> {
      match export_memories(db) {
        case Ok(json) -> out.print(json)
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case Import(file) -> {
      match import_memories(db, file) {
        case Ok(result) -> {
          let mut json = '{"success": true, "imported": ${result.imported}, "failed": ${result.failed}'

          if result.first_error != '' {
            json = json
              + ', "first_error": "${escape_json(result.first_error)}"'
          }

          json = json + '}'
          out.print(json)
        }
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case AgentsMd(path) -> {
      match generate_agents_md(db, path) {
        case Ok(_) -> out.print('{"success": true}')
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case Stats -> {
      match get_stats(db) {
        case Ok(stats) -> {
          out.print(
            '{"total": ${stats.total}, "active": ${stats.active}, "pinned": ${stats.pinned}, "anti_pattern": ${stats.anti_pattern}, "avg_strength": ${(stats.avg_strength as Float).to_string}}',
          )
        }
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case Update(id, content, tags, scope) -> {
      match update_memory(db, id, content, tags, scope) {
        case Ok(new_id) -> {
          out.print('{"success": true, "new_id": ${new_id}, "old_id": ${id}}')
        }
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case History(id) -> {
      match get_history(db, id) {
        case Ok(result) -> output_history(result, out)
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
    case Contradictions(resolve_id) -> {
      match resolve_id {
        case Some(rid) -> {
          match resolve_contradiction(db, rid) {
            case Ok(resolved) -> {
              out.print('{"success": ${resolved}, "resolved_id": ${rid}}')
            }
            case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
          }
        }
        case None -> {
          match list_contradictions(db) {
            case Ok(mems) -> output_contradictions(mems, out)
            case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
          }
        }
      }
    }
    case RebuildFts -> {
      match rebuild_fts(db) {
        case Ok(count) -> out.print('{"success": true, "indexed": ${count}}')
        case Error(e) -> out.print('{"error": "${escape_json(e)}"}')
      }
    }
  }
}
