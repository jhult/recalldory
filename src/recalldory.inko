import cli (parse_args, Command, ParsedArgs)
import db (Database, Statement, init_schema, migrate_schema, SQLITE_ROW, SQLITE_DONE)
import std.env
import std.stdio (Stdout)
import std.string (StringBuffer, IntoString)
import std.crypto.sha2 (Sha256)
import std.json (Json)
import std.fs.file (ReadOnlyFile, WriteOnlyFile)
import std.fs.path (Path)
import std.bytes (ByteArray)
import std.io (Buffer, Write)
import std.map (Map)

# Common words to ignore for entity extraction
let COMMON_WORDS = ["the", "that", "this", "with", "from", "have", "been", "were",
                    "what", "when", "where", "which", "while", "about", "would",
                    "could", "should", "their", "there", "these", "those", "being"]

# Negation words for contradiction detection
let NEGATION_WORDS = ["not", "never", "dont", "avoid", "cannot", "neither",
                      "nobody", "nothing", "nowhere", "none"]

type async Main {
  fn async main {
    let out = Stdout.new

    match parse_args {
      case Some(parsed) -> {
        let global = parsed.global
        let cmd = parsed.into_command
        match cmd {
          case HookPostCompact -> {
            handle_hook_post_compact(out)
          }
          case HookInstall -> {
            handle_hook_install(out)
          }
          case Add(a, b, c, d) -> run_with_db(Command.Add(a, b, c, d), global, out)
          case Recall(a, b, c) -> run_with_db(Command.Recall(a, b, c), global, out)
          case List(a, b, c) -> run_with_db(Command.List(a, b, c), global, out)
          case Forget(a) -> run_with_db(Command.Forget(a), global, out)
          case Pin(a) -> run_with_db(Command.Pin(a), global, out)
          case Unpin(a) -> run_with_db(Command.Unpin(a), global, out)
          case Feedback(a, b) -> run_with_db(Command.Feedback(a, b), global, out)
          case Maintain(a) -> run_with_db(Command.Maintain(a), global, out)
          case AgentsMd(a) -> run_with_db(Command.AgentsMd(a), global, out)
          case Stats -> run_with_db(Command.Stats, global, out)
          case Export -> run_with_db(Command.Export, global, out)
          case Import(a) -> run_with_db(Command.Import(a), global, out)
          case Update(a, b, c, d) -> run_with_db(Command.Update(a, b, c, d), global, out)
          case History(a) -> run_with_db(Command.History(a), global, out)
          case Contradictions(a) -> run_with_db(Command.Contradictions(a), global, out)
        }
      }
      case None -> {
        out.print("{\"error\": \"No command provided\"}")
      }
    }
  }
}

fn run_with_db(cmd: Command, global: Bool, out: Stdout) {
  match open_database(global) {
    case Ok(db) -> {
      let mut database = db
      handle_command(cmd, database, out)
      database.close
    }
    case Error(e) -> {
      out.print("{\"error\": \"${escape_json(e)}\"}")
    }
  }
}

fn handle_hook_post_compact(out: Stdout) {
  let mut context = "IMPORTANT: Context was just compacted. Here are your preserved memories:\\n\\n"
  let mut has_memories = false

  # Query local project memories
  match open_database(false) {
    case Ok(db) -> {
      let mut local_db = db
      match list_memories(local_db, "", "", 10) {
        case Ok(mems) -> {
          if mems.size > 0 {
            has_memories = true
            context = context + "## Project Memories\\n"
            for mem in mems.iter {
              context = context + "- [" + mem.status + "] " + escape_json(mem.content) + "\\n"
            }
            context = context + "\\n"
          }
        }
        case Error(_) -> {}
      }
      local_db.close
    }
    case Error(_) -> {}
  }

  # Query global memories
  match open_database(true) {
    case Ok(db) -> {
      let mut global_db = db
      match list_memories(global_db, "", "", 10) {
        case Ok(mems) -> {
          if mems.size > 0 {
            has_memories = true
            context = context + "## Global Memories\\n"
            for mem in mems.iter {
              context = context + "- [" + mem.status + "] " + escape_json(mem.content) + "\\n"
            }
          }
        }
        case Error(_) -> {}
      }
      global_db.close
    }
    case Error(_) -> {}
  }

  if has_memories {
    out.print("{\"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": \"${context}\"}}")
  } else {
    out.print("{\"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": \"\"}}")
  }
}

fn handle_hook_install(out: Stdout) {
  # Resolve path to this executable for the hook command
  let exe_path = match env.executable {
    case Ok(p) -> p.to_string
    case Error(_) -> {
      out.print("{\"error\": \"Cannot determine recalldory executable path\"}")
      return
    }
  }

  let home = match env.get("HOME") {
    case Ok(h) -> h
    case Error(_) -> {
      out.print("{\"error\": \"HOME not set\"}")
      return
    }
  }

  let settings_path = "${home}/.claude/settings.json"
  let settings_file = settings_path.to_path

  # Read existing settings or start with empty object
  let mut root = match ReadOnlyFile.new(settings_file) {
    case Ok(f) -> {
      let mut file = f
      let mut bytes = ByteArray.new
      let _ = file.read_all(bytes)
      let content = bytes.into_string
      let buffer = Buffer.new(content)
      match Json.parse(buffer) {
        case Ok(json) -> json
        case Error(_) -> {
          out.print("{\"error\": \"Failed to parse existing settings.json: file may be corrupted. Fix it manually or remove it and retry.\"}")
          return
        }
      }
    }
    case Error(_) -> Json.Object(Map.new)
  }

  # Build the hook entry:
  # { "matcher": "compact", "hooks": [{ "type": "command", "command": "<exe> hook post-compact" }] }
  let mut inner_hook: Map[String, Json] = Map.new
  inner_hook.set("type", Json.String("command"))
  inner_hook.set("command", Json.String("${exe_path} hook post-compact"))

  let mut matcher_obj: Map[String, Json] = Map.new
  matcher_obj.set("matcher", Json.String("compact"))
  matcher_obj.set("hooks", Json.Array([Json.Object(inner_hook)]))

  let recalldory_entry = Json.Object(matcher_obj)

  # Get or create the hooks object, then set SessionStart
  match mut root {
    case Object(root_map) -> {
      match root_map.get("hooks") {
        case Ok(hooks_val) -> {
          match hooks_val {
            case Object(_) -> {}
            case _ -> {
              # hooks exists but isn't an object — replace it
              root_map.set("hooks", Json.Object(Map.new))
            }
          }
        }
        case Error(_) -> {
          root_map.set("hooks", Json.Object(Map.new))
        }
      }

      # Now get the hooks map mutably and set SessionStart
      match root_map.get_mut("hooks") {
        case Ok(hooks_json) -> {
          match mut hooks_json {
            case Object(hooks_map) -> {
              # Check if SessionStart already has a compact matcher from recalldory
              let mut already_installed = false
              match hooks_map.get("SessionStart") {
                case Ok(ss) -> {
                  match ss {
                    case Array(arr) -> {
                      for entry in arr.iter {
                        match entry {
                          case Object(entry_map) -> {
                            match entry_map.get("matcher") {
                              case Ok(m) -> {
                                match m {
                                  case String(s) if s == "compact" -> {
                                    already_installed = true
                                  }
                                  case _ -> {}
                                }
                              }
                              case Error(_) -> {}
                            }
                          }
                          case _ -> {}
                        }
                      }
                    }
                    case _ -> {}
                  }
                }
                case Error(_) -> {}
              }

              if already_installed {
                out.print("{\"success\": true, \"message\": \"Hook already installed\"}")
                return
              }

              # Add our entry to SessionStart array (or create it)
              match hooks_map.get("SessionStart") {
                case Ok(ss) -> {
                  match ss {
                    case Array(_) -> {
                      # Append to existing array
                      match hooks_map.get_mut("SessionStart") {
                        case Ok(ss_mut) -> {
                          match mut ss_mut {
                            case Array(arr) -> arr.push(recalldory_entry)
                            case _ -> {}
                          }
                        }
                        case Error(_) -> {}
                      }
                    }
                    case _ -> {
                      hooks_map.set("SessionStart", Json.Array([recalldory_entry]))
                    }
                  }
                }
                case Error(_) -> {
                  hooks_map.set("SessionStart", Json.Array([recalldory_entry]))
                }
              }
            }
            case _ -> {}
          }
        }
        case Error(_) -> {}
      }
    }
    case _ -> {
      out.print("{\"error\": \"settings.json root is not an object\"}")
      return
    }
  }

  # Write back with pretty printing
  let output = root.to_pretty_string + "\n"
  match WriteOnlyFile.new(settings_file) {
    case Ok(f) -> {
      let mut file = f
      match file.write(output.to_byte_array) {
        case Ok(_) -> {
          let _ = file.flush
          out.print("{\"success\": true, \"message\": \"Hook installed to ${settings_path}\"}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"Failed to write settings: ${e}\"}")
        }
      }
    }
    case Error(e) -> {
      out.print("{\"error\": \"Failed to open settings for writing: ${e}\"}")
    }
  }
}

fn open_database(global: Bool) -> Result[Database, String] {
  let path = if global {
    let home = match env.get("HOME") {
      case Ok(h) -> h
      case Error(_) -> return Result.Error("HOME not set")
    }
    let dir = "${home}/.recalldory".to_path
    dir.create_directory
    "${home}/.recalldory/memory.db"
  } else {
    let dir = ".recalldory".to_path
    dir.create_directory
    "./.recalldory/memory.db"
  }

  let db = match Database.new(path) {
    case Ok(d) -> d
    case Error(e) -> return Result.Error("Failed to open database: ${e}")
  }

  match init_schema(db) {
    case Error(e) -> {
      db.close
      return Result.Error("Failed to initialize schema: ${e}")
    }
    case Ok(_) -> { }
  }

  # Run migrations for existing databases
  let _ = migrate_schema(db)

  Result.Ok(db)
}

fn handle_command(cmd: Command, db: mut Database, out: Stdout) {
  match cmd {
    case Add(content, tags, scope, pin) -> {
      match add_memory(db, content, tags, scope, pin) {
        case Ok(id) -> {
          out.print("{\"success\": true, \"id\": ${id}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Recall(query, scope, top) -> {
      match search_memories(db, query, scope, top) {
        case Ok(mems) -> {
          output_memories(mems, out)
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case List(scope, status, limit) -> {
      match list_memories(db, scope, status, limit) {
        case Ok(mems) -> {
          output_memories(mems, out)
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Forget(id) -> {
      match forget_memory(db, id) {
        case Ok(deleted) -> {
          out.print("{\"success\": ${deleted}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Pin(id) -> {
      match pin_memory(db, id) {
        case Ok(pinned) -> {
          out.print("{\"success\": ${pinned}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Unpin(id) -> {
      match unpin_memory(db, id) {
        case Ok(unpinned) -> {
          out.print("{\"success\": ${unpinned}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Feedback(id, feedback_type) -> {
      match feedback_memory(db, id, feedback_type) {
        case Ok(updated) -> {
          out.print("{\"success\": ${updated}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Maintain(dry_run) -> {
      match maintain_memory(db, dry_run) {
        case Ok(stats) -> {
          out.print("{\"decayed\": ${stats.decayed}, \"anti_patterns\": ${stats.anti_patterns}, \"pruned\": ${stats.pruned}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Export -> {
      match export_memories(db) {
        case Ok(json) -> {
          out.print(json)
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Import(file) -> {
      match import_memories(db, file) {
        case Ok(count) -> {
          out.print("{\"success\": true, \"imported\": ${count}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case AgentsMd(path) -> {
      match generate_agents_md(db, path) {
        case Ok(_) -> {
          out.print("{\"success\": true}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Stats -> {
      match get_stats(db) {
        case Ok(stats) -> {
          out.print("{\"total\": ${stats.total}, \"active\": ${stats.active}, \"pinned\": ${stats.pinned}, \"anti_pattern\": ${stats.anti_pattern}, \"avg_strength\": ${(stats.avg_strength as Float).to_string}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case HookPostCompact -> {
      # Handled in main before DB open; this branch is unreachable
    }
    case HookInstall -> {
      # Handled in main before DB open; this branch is unreachable
    }
    case Update(id, content, tags, scope) -> {
      match update_memory(db, id, content, tags, scope) {
        case Ok(new_id) -> {
          out.print("{\"success\": true, \"new_id\": ${new_id}, \"old_id\": ${id}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case History(id) -> {
      match get_history(db, id) {
        case Ok(mems) -> {
          output_history(mems, out)
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Contradictions(resolve_id) -> {
      match resolve_id {
        case Some(rid) -> {
          match resolve_contradiction(db, rid) {
            case Ok(resolved) -> {
              out.print("{\"success\": ${resolved}, \"resolved_id\": ${rid}}")
            }
            case Error(e) -> {
              out.print("{\"error\": \"${e}\"}")
            }
          }
        }
        case None -> {
          match list_contradictions(db) {
            case Ok(mems) -> {
              output_contradictions(mems, out)
            }
            case Error(e) -> {
              out.print("{\"error\": \"${e}\"}")
            }
          }
        }
      }
    }
  }
}

fn add_memory(db: mut Database, content: String, tags: String, scope: String, pin: Bool) -> Result[Int, String] {
  let _ = db.exec("BEGIN")
  match add_memory_inner(db, content, tags, scope, pin) {
    case Ok(v) -> {
      let _ = db.exec("COMMIT")
      Result.Ok(v)
    }
    case Error(e) -> {
      let _ = db.exec("ROLLBACK")
      Result.Error(e)
    }
  }
}

fn add_memory_inner(db: mut Database, content: String, tags: String, scope: String, pin: Bool) -> Result[Int, String] {
  let hash = sha256_hash(content)
  let simhash_val = simhash(content)
  let status = if pin { "pinned" } else { "active" }

  # Check for exact duplicate first
  let check_sql = "SELECT id, access_count FROM memories WHERE content_hash = ?"
  let mut stmt = match db.prepare(check_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_text(1, hash) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let mut existing_id: Option[Int] = Option.None
  let mut existing_count = 0

  if stmt.step == SQLITE_ROW {
    existing_id = Option.Some(stmt.column_int(0))
    existing_count = stmt.column_int(1)
  }
  stmt.finalize

  match existing_id {
    case Some(id) -> {
      let update_sql = "UPDATE memories SET access_count = ?, last_accessed = datetime('now'), storage_strength = MIN(10.0, storage_strength + 0.1) WHERE id = ?"
      let mut update_stmt = match db.prepare(update_sql) {
        case Ok(s) -> s
        case Error(e) -> return Result.Error("Failed to prepare: ${e}")
      }
      match update_stmt.bind_int(1, existing_count + 1) {
        case Error(e) -> {
          update_stmt.finalize
          return Result.Error("Failed to bind: ${e}")
        }
        case Ok(_) -> { }
      }
      match update_stmt.bind_int(2, id) {
        case Error(e) -> {
          update_stmt.finalize
          return Result.Error("Failed to bind: ${e}")
        }
        case Ok(_) -> { }
      }
      let _ = update_stmt.step
      update_stmt.finalize
      return Result.Ok(id)
    }
    case None -> { }
  }

  # Check for near-duplicate using SimHash (Hamming distance <= 3)
  let near_dup_sql = "SELECT id, access_count, simhash FROM memories WHERE simhash IS NOT NULL AND status != 'superseded'"
  let mut near_dup_stmt = match db.prepare(near_dup_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare near-dup check: ${e}")
  }

  let new_simhash_int = hex_to_int(simhash_val)
  let mut near_dup_id: Option[Int] = Option.None
  let mut near_dup_count = 0

  loop {
    let step_result = near_dup_stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      break
    }

    let existing_id = near_dup_stmt.column_int(0)
    let existing_count = near_dup_stmt.column_int(1)
    let existing_simhash_str = near_dup_stmt.column_text(2)

    if existing_simhash_str != "" {
      let existing_simhash_int = hex_to_int(existing_simhash_str)
      let dist = hamming_distance(new_simhash_int, existing_simhash_int)

      if dist <= 3 {
        near_dup_id = Option.Some(existing_id)
        near_dup_count = existing_count
        break
      }
    }
  }
  near_dup_stmt.finalize

  match near_dup_id {
    case Some(id) -> {
      # Near-duplicate found: increment access count instead of creating new memory
      let update_sql = "UPDATE memories SET access_count = ?, last_accessed = datetime('now'), storage_strength = MIN(10.0, storage_strength + 0.1) WHERE id = ?"
      let mut update_stmt = match db.prepare(update_sql) {
        case Ok(s) -> s
        case Error(e) -> return Result.Error("Failed to prepare: ${e}")
      }
      match update_stmt.bind_int(1, near_dup_count + 1) {
        case Error(e) -> {
          update_stmt.finalize
          return Result.Error("Failed to bind: ${e}")
        }
        case Ok(_) -> { }
      }
      match update_stmt.bind_int(2, id) {
        case Error(e) -> {
          update_stmt.finalize
          return Result.Error("Failed to bind: ${e}")
        }
        case Ok(_) -> { }
      }
      let _ = update_stmt.step
      update_stmt.finalize
      return Result.Ok(id)
    }
    case None -> { }
  }

  # Check for contradictions before inserting
  let (is_contradiction, raw_contradicts_id) = check_contradiction(db, content)

  # Extract the id value for reuse
  let contradicts_id_val = match raw_contradicts_id {
    case Some(cid) -> cid
    case None -> -1
  }
  let has_contradicts = contradicts_id_val >= 0

  let insert_sql = "INSERT INTO memories (content, content_hash, tags, scope, status, simhash, is_contradiction, contradicts_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?)"
  let mut insert_stmt = match db.prepare(insert_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match insert_stmt.bind_text(1, content) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(2, hash) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(3, tags) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(4, scope) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(5, status) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(6, simhash_val) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_int(7, if is_contradiction { 1 } else { 0 }) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  if has_contradicts {
    match insert_stmt.bind_int(8, contradicts_id_val) {
      case Error(e) -> {
        insert_stmt.finalize
        return Result.Error("Failed to bind: ${e}")
      }
      case Ok(_) -> { }
    }
  } else {
    match insert_stmt.bind_null(8) {
      case Error(e) -> {
        insert_stmt.finalize
        return Result.Error("Failed to bind: ${e}")
      }
      case Ok(_) -> { }
    }
  }

  let result = insert_stmt.step
  insert_stmt.finalize

  if result != SQLITE_DONE {
    return Result.Error("Insert failed")
  }

  let memory_id = db.last_insert_rowid as Int

  # If contradiction found, supersede the old memory
  if is_contradiction and has_contradicts {
    let supersede_sql = "UPDATE memories SET status = 'superseded', updated_at = datetime('now') WHERE id = ?"
    let mut supersede_stmt = match db.prepare(supersede_sql) {
      case Ok(s) -> s
      case Error(_) -> return Result.Ok(memory_id)
    }
    match supersede_stmt.bind_int(1, contradicts_id_val) {
      case Error(_) -> {}
      case Ok(_) -> { let _ = supersede_stmt.step }
    }
    supersede_stmt.finalize
  }

  # Index in FTS5 with explicit rowid matching memory id
  let fts_sql = "INSERT INTO memories_fts (rowid, content, tags, summary) VALUES (?, ?, ?, ?)"
  let mut fts_stmt = match db.prepare(fts_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare FTS: ${e}")
  }

  match fts_stmt.bind_int(1, memory_id) {
    case Error(e) -> {
      fts_stmt.finalize
      return Result.Error("Failed to bind FTS: ${e}")
    }
    case Ok(_) -> { }
  }
  match fts_stmt.bind_text(2, content) {
    case Error(e) -> {
      fts_stmt.finalize
      return Result.Error("Failed to bind FTS: ${e}")
    }
    case Ok(_) -> { }
  }
  match fts_stmt.bind_text(3, tags) {
    case Error(e) -> {
      fts_stmt.finalize
      return Result.Error("Failed to bind FTS: ${e}")
    }
    case Ok(_) -> { }
  }
  match fts_stmt.bind_text(4, "") {
    case Error(e) -> {
      fts_stmt.finalize
      return Result.Error("Failed to bind FTS: ${e}")
    }
    case Ok(_) -> { }
  }

  let fts_result = fts_stmt.step
  fts_stmt.finalize

  if fts_result != SQLITE_DONE {
    return Result.Error("FTS indexing failed")
  }

  Result.Ok(memory_id)
}

fn list_memories(db: mut Database, scope_filter: String, status_filter: String, limit: Int) -> Result[Array[Memory], String] {
  let mut sql = "SELECT id, content, content_hash, summary, tags, scope, status, is_negative, strength, access_count, decay_rate, helpful_count, harmful_count, created_at, updated_at, last_accessed FROM memories WHERE 1=1"

  if scope_filter != "" {
    sql = sql + " AND scope = ?"
  }
  if status_filter != ""{
    sql = sql + " AND status = ?"
  }

  sql = sql + " ORDER BY last_accessed DESC LIMIT ?"

  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  let mut idx = 1
  if scope_filter != "" {
    match stmt.bind_text(idx, scope_filter) {
      case Error(e) -> {
        stmt.finalize
        return Result.Error("Failed to bind: ${e}")
      }
      case Ok(_) -> { }
    }
    idx = idx + 1
  }
  if status_filter != ""{
    match stmt.bind_text(idx, status_filter) {
      case Error(e) -> {
        stmt.finalize
        return Result.Error("Failed to bind: ${e}")
      }
      case Ok(_) -> { }
    }
    idx = idx + 1
  }
  match stmt.bind_int(idx, limit) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let mut results = []
  loop {
    let step_result = stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      stmt.finalize
      return Result.Error("Query failed")
    }
    results.push(Memory.from_row(ref stmt))
  }
  stmt.finalize

  Result.Ok(results)
}

fn search_memories(db: mut Database, query: String, scope_filter: String, limit: Int) -> Result[Array[Memory], String] {
  # Use FTS5 for full-text search with bm25 ranking
  # Include bm25 score for combined scoring
  let mut sql = "SELECT m.id, m.content, m.content_hash, m.summary, m.tags, m.scope, m.status, m.is_negative, m.strength, m.access_count, m.decay_rate, m.helpful_count, m.harmful_count, m.created_at, m.updated_at, m.last_accessed, bm25(memories_fts) as similarity_score FROM memories m JOIN memories_fts fts ON m.id = fts.rowid WHERE memories_fts MATCH ? AND m.status NOT IN ('superseded', 'anti-pattern', 'deleted')"

  if scope_filter != "" {
    sql = sql + " AND m.scope = ?"
  }

  sql = sql + " ORDER BY bm25(memories_fts) LIMIT ?"

  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_text(1, query) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let mut idx = 2
  if scope_filter != "" {
    match stmt.bind_text(idx, scope_filter) {
      case Error(e) -> {
        stmt.finalize
        return Result.Error("Failed to bind: ${e}")
      }
      case Ok(_) -> { }
    }
    idx = idx + 1
  }
  match stmt.bind_int(idx, limit) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let mut results = []
  loop {
    let step_result = stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      stmt.finalize
      return Result.Error("Query failed")
    }
    results.push(Memory.from_row_with_score(ref stmt))
  }
  stmt.finalize

  # Update last_accessed and retrieval_strength for returned memories
  for mem in results.iter {
    let touch_sql = "UPDATE memories SET last_accessed = datetime('now'), retrieval_strength = MIN(1.0, retrieval_strength + 0.1), access_count = access_count + 1 WHERE id = ?"
    let mut touch_stmt = match db.prepare(touch_sql) {
      case Ok(s) -> s
      case Error(_) -> next
    }
    match touch_stmt.bind_int(1, mem.id) {
      case Ok(_) -> { let _ = touch_stmt.step }
      case Error(_) -> {}
    }
    touch_stmt.finalize
  }

  Result.Ok(results)
}

fn forget_memory(db: mut Database, id: Int) -> Result[Bool, String] {
  let _ = db.exec("BEGIN")
  match forget_memory_inner(db, id) {
    case Ok(v) -> {
      let _ = db.exec("COMMIT")
      Result.Ok(v)
    }
    case Error(e) -> {
      let _ = db.exec("ROLLBACK")
      Result.Error(e)
    }
  }
}

fn forget_memory_inner(db: mut Database, id: Int) -> Result[Bool, String] {
  let sql = "DELETE FROM memories WHERE id = ?"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_int(1, id) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let _ = stmt.step
  stmt.finalize

  let deleted = db.changes > 0

  # Clean up FTS entry
  if deleted {
    let fts_sql = "DELETE FROM memories_fts WHERE rowid = ?"
    let mut fts_stmt = match db.prepare(fts_sql) {
      case Ok(s) -> s
      case Error(e) -> return Result.Error("Failed to clean FTS: ${e}")
    }
    match fts_stmt.bind_int(1, id) {
      case Error(e) -> {
        fts_stmt.finalize
        return Result.Error("Failed to bind FTS: ${e}")
      }
      case Ok(_) -> { }
    }
    let _ = fts_stmt.step
    fts_stmt.finalize
  }

  Result.Ok(deleted)
}

fn pin_memory(db: mut Database, id: Int) -> Result[Bool, String] {
  let sql = "UPDATE memories SET status = 'pinned', updated_at = datetime('now') WHERE id = ? AND status != 'pinned'"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_int(1, id) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let _ = stmt.step
  stmt.finalize
  Result.Ok(db.changes > 0)
}

fn unpin_memory(db: mut Database, id: Int) -> Result[Bool, String]{
  let sql = "UPDATE memories SET status = 'active', updated_at = datetime('now') WHERE id = ? AND status = 'pinned'"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_int(1, id) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let _ = stmt.step
  stmt.finalize
  Result.Ok(db.changes > 0)
}

fn feedback_memory(db: mut Database, id: Int, feedback_type: String) -> Result[Bool, String] {
  if feedback_type != "helpful" and feedback_type != "harmful" {
    return Result.Error("Invalid feedback type: must be 'helpful' or 'harmful'")
  }

  let column = if feedback_type == "helpful" { "helpful_count" } else { "harmful_count" }
  let sql = "UPDATE memories SET ${column} = ${column} + 1, updated_at = datetime('now') WHERE id = ?"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_int(1, id) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let _ = stmt.step
  stmt.finalize
  Result.Ok(db.changes > 0)
}

# Version chain: update a memory by creating a new version
fn update_memory(db: mut Database, id: Int, content: String, tags: String, scope: String) -> Result[Int, String] {
  let _ = db.exec("BEGIN")
  match update_memory_inner(db, id, content, tags, scope) {
    case Ok(v) -> {
      let _ = db.exec("COMMIT")
      Result.Ok(v)
    }
    case Error(e) -> {
      let _ = db.exec("ROLLBACK")
      Result.Error(e)
    }
  }
}

fn update_memory_inner(db: mut Database, id: Int, content: String, tags: String, scope: String) -> Result[Int, String] {
  # Get the old memory to copy metadata
  let get_sql = "SELECT tags, scope FROM memories WHERE id = ?"
  let mut get_stmt = match db.prepare(get_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match get_stmt.bind_int(1, id) {
    case Error(e) -> {
      get_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let mut old_tags = tags
  let mut old_scope = scope

  if get_stmt.step == SQLITE_ROW {
    if tags == "" {
      old_tags = get_stmt.column_text(0)
    }
    if scope == "" {
      old_scope = get_stmt.column_text(1)
    }
  }
  get_stmt.finalize

  # Mark old memory as superseded
  let supersede_sql = "UPDATE memories SET status = 'superseded', updated_at = datetime('now') WHERE id = ?"
  let mut supersede_stmt = match db.prepare(supersede_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }
  match supersede_stmt.bind_int(1, id) {
    case Error(e) -> {
      supersede_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  let _ = supersede_stmt.step
  supersede_stmt.finalize

  # Clean up FTS entry for superseded memory
  let fts_del_sql = "DELETE FROM memories_fts WHERE rowid = ?"
  let mut fts_del_stmt = match db.prepare(fts_del_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare FTS cleanup: ${e}")
  }
  match fts_del_stmt.bind_int(1, id) {
    case Error(e) -> {
      fts_del_stmt.finalize
      return Result.Error("Failed to bind FTS cleanup: ${e}")
    }
    case Ok(_) -> { }
  }
  let _ = fts_del_stmt.step
  fts_del_stmt.finalize

  # Create new memory with parent_id pointing to old memory
  let hash = sha256_hash(content)
  let simhash_val = simhash(content)
  let insert_sql = "INSERT INTO memories (content, content_hash, tags, scope, status, simhash, parent_id) VALUES (?, ?, ?, ?, 'active', ?, ?)"
  let mut insert_stmt = match db.prepare(insert_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match insert_stmt.bind_text(1, content) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(2, hash) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(3, old_tags) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(4, old_scope) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(5, simhash_val) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_int(6, id) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let result = insert_stmt.step
  insert_stmt.finalize

  if result != SQLITE_DONE {
    return Result.Error("Insert failed")
  }

  let new_id = db.last_insert_rowid as Int

  # Index in FTS5 with explicit rowid matching memory id
  let fts_sql = "INSERT INTO memories_fts (rowid, content, tags, summary) VALUES (?, ?, ?, ?)"
  let mut fts_stmt = match db.prepare(fts_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare FTS: ${e}")
  }

  match fts_stmt.bind_int(1, new_id) {
    case Error(e) -> {
      fts_stmt.finalize
      return Result.Error("Failed to bind FTS: ${e}")
    }
    case Ok(_) -> { }
  }
  match fts_stmt.bind_text(2, content) {
    case Error(e) -> {
      fts_stmt.finalize
      return Result.Error("Failed to bind FTS: ${e}")
    }
    case Ok(_) -> { }
  }
  match fts_stmt.bind_text(3, old_tags) {
    case Error(e) -> {
      fts_stmt.finalize
      return Result.Error("Failed to bind FTS: ${e}")
    }
    case Ok(_) -> { }
  }
  match fts_stmt.bind_text(4, "") {
    case Error(e) -> {
      fts_stmt.finalize
      return Result.Error("Failed to bind FTS: ${e}")
    }
    case Ok(_) -> { }
  }

  let fts_result = fts_stmt.step
  fts_stmt.finalize

  if fts_result != SQLITE_DONE {
    return Result.Error("FTS indexing failed")
  }

  Result.Ok(new_id)
}

# Get version history for a memory (follow parent_id chain)
fn get_history(db: mut Database, id: Int) -> Result[Array[Memory], String] {
  let mut history: Array[Memory] = []

  # Get current memory
  let sql = "SELECT id, content, content_hash, summary, tags, scope, status, is_negative, strength, access_count, decay_rate, helpful_count, harmful_count, created_at, updated_at, last_accessed, parent_id FROM memories WHERE id = ?"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_int(1, id) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let mut current_id: Option[Int] = Option.None

  if stmt.step == SQLITE_ROW {
    current_id = Option.Some(stmt.column_int(0))
    history.push(Memory.from_row_with_parent(ref stmt))
  }
  stmt.finalize

  # Follow parent chain
  let mut visited: Array[Int] = []
  match current_id {
    case Some(cid) -> {
      visited.push(cid)
      let mut next_parent = get_parent_id(db, cid)
      loop {
        match next_parent {
          case Some(pid) -> {
            # Check if already visited
            let mut already_visited = false
            for v in visited.iter {
              if v == pid {
                already_visited = true
              }
            }
            if already_visited {
              break
            }
            visited.push(pid)

            let parent_sql = "SELECT id, content, content_hash, summary, tags, scope, status, is_negative, strength, access_count, decay_rate, helpful_count, harmful_count, created_at, updated_at, last_accessed, parent_id FROM memories WHERE id = ?"
            let mut parent_stmt = match db.prepare(parent_sql) {
              case Ok(s) -> s
              case Error(_) -> break
            }

            match parent_stmt.bind_int(1, pid) {
              case Error(_) -> {
                parent_stmt.finalize
                break
              }
              case Ok(_) -> { }
            }

            if parent_stmt.step == SQLITE_ROW {
              history.push(Memory.from_row_with_parent(ref parent_stmt))
              next_parent = get_parent_id(db, pid)
            } else {
              next_parent = Option.None
            }
            parent_stmt.finalize
          }
          case None -> break
        }
      }
    }
    case None -> { }
  }

  Result.Ok(history)
}

fn get_parent_id(db: mut Database, id: Int) -> Option[Int] {
  let sql = "SELECT parent_id FROM memories WHERE id = ?"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(_) -> return Option.None
  }

  match stmt.bind_int(1, id) {
    case Error(_) -> {
      stmt.finalize
      return Option.None
    }
    case Ok(_) -> { }
  }

  let result = if stmt.step == SQLITE_ROW {
    let parent_id = stmt.column_int(0)
    if parent_id > 0 {
      Option.Some(parent_id)
    } else {
      Option.None
    }
  } else {
    Option.None
  }
  stmt.finalize
  result
}

# List all flagged contradictions
fn list_contradictions(db: mut Database) -> Result[Array[Memory], String] {
  let sql = "SELECT id, content, content_hash, summary, tags, scope, status, is_negative, strength, access_count, decay_rate, helpful_count, harmful_count, created_at, updated_at, last_accessed, contradicts_id FROM memories WHERE is_contradiction = 1 ORDER BY created_at DESC"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  let mut results: Array[Memory] = []
  loop {
    let step_result = stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      stmt.finalize
      return Result.Error("Query failed")
    }
    results.push(Memory.from_row_with_contradicts(ref stmt))
  }
  stmt.finalize

  Result.Ok(results)
}

# Resolve a contradiction by keeping both memories
fn resolve_contradiction(db: mut Database, id: Int) -> Result[Bool, String] {
  let sql = "UPDATE memories SET is_contradiction = 0, contradicts_id = NULL, updated_at = datetime('now') WHERE id = ?"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_int(1, id) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let _ = stmt.step
  stmt.finalize
  Result.Ok(db.changes > 0)
}

type pub MaintainStats {
  let @decayed: Int
  let @anti_patterns: Int
  let @pruned: Int
}

fn maintain_memory(db: mut Database, dry_run: Bool) -> Result[MaintainStats, String] {
  let mut decayed = 0
  let mut anti_patterns = 0
  let mut pruned = 0

  # Dual-strength decay:
  # retrieval_strength decays via power law: retrieval * (1 - decay_rate * hours)
  # storage_strength accumulates and never decays (already done on access)
  # Combined score: 0.7 * retrieval_strength + 0.3 * (storage_strength / 10.0)

  # Decay retrieval_strength based on time since last access
  let decay_sql = "UPDATE memories SET retrieval_strength = MAX(0.0, retrieval_strength * (1 - decay_rate * (julianday('now') - julianday(last_accessed)) * 24)), strength = 0.7 * MAX(0.0, retrieval_strength * (1 - decay_rate * (julianday('now') - julianday(last_accessed)) * 24)) + 0.3 * (storage_strength / 10.0), updated_at = datetime('now') WHERE status != 'pinned' AND status != 'superseded' AND retrieval_strength > 0.05"
  if !dry_run {
    let mut decay_stmt = match db.prepare(decay_sql) {
      case Ok(s) -> s
      case Error(e) -> return Result.Error("Failed to prepare decay: ${e}")
    }
    let _ = decay_stmt.step
    decayed = db.changes
    decay_stmt.finalize
  }

  # Mark anti-pattern memories (harmful_count >= 3)
  let anti_sql = "UPDATE memories SET status = 'anti-pattern', is_negative = 1, updated_at = datetime('now') WHERE harmful_count >= 3 AND status != 'pinned' AND status != 'anti-pattern' AND status != 'superseded'"
  if !dry_run {
    let mut anti_stmt = match db.prepare(anti_sql) {
      case Ok(s) -> s
      case Error(e) -> return Result.Error("Failed to prepare anti-pattern: ${e}")
    }
    let _ = anti_stmt.step
    anti_patterns = db.changes
    anti_stmt.finalize
  }

  # Prune low-strength unpinned memories (using combined score < 0.05)
  # First, delete matching FTS entries before removing from memories
  if !dry_run {
    let fts_prune_sql = "DELETE FROM memories_fts WHERE rowid IN (SELECT id FROM memories WHERE status != 'pinned' AND status != 'superseded' AND strength < 0.05)"
    let _ = db.exec(fts_prune_sql)

    let prune_sql = "DELETE FROM memories WHERE status != 'pinned' AND status != 'superseded' AND strength < 0.05"
    let mut prune_stmt = match db.prepare(prune_sql) {
      case Ok(s) -> s
      case Error(e) -> return Result.Error("Failed to prepare prune: ${e}")
    }
    let _ = prune_stmt.step
    pruned = db.changes
    prune_stmt.finalize
  }

  Result.Ok(MaintainStats(decayed: decayed, anti_patterns: anti_patterns, pruned: pruned))
}

type pub MemoryStats {
  let @total: Int
  let @active: Int
  let @pinned: Int
  let @anti_pattern: Int
  let @avg_strength: Float64
}

fn get_stats(db: mut Database) -> Result[MemoryStats, String] {
  let total_sql = "SELECT COUNT(*) FROM memories"
  let mut total_stmt = match db.prepare(total_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }
  let total = if total_stmt.step == SQLITE_ROW {
    total_stmt.column_int(0)
  } else {
    0
  }
  total_stmt.finalize

  let active_sql = "SELECT COUNT(*) FROM memories WHERE status = 'active'"
  let mut active_stmt = match db.prepare(active_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }
  let active = if active_stmt.step == SQLITE_ROW {
    active_stmt.column_int(0)
  } else {
    0
  }
  active_stmt.finalize

  let pinned_sql = "SELECT COUNT(*) FROM memories WHERE status = 'pinned'"
  let mut pinned_stmt = match db.prepare(pinned_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }
  let pinned = if pinned_stmt.step == SQLITE_ROW {
    pinned_stmt.column_int(0)
  } else {
    0
  }
  pinned_stmt.finalize

  let anti_sql = "SELECT COUNT(*) FROM memories WHERE status = 'anti-pattern'"
  let mut anti_stmt = match db.prepare(anti_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }
  let anti_pattern = if anti_stmt.step == SQLITE_ROW {
    anti_stmt.column_int(0)
  } else {
    0
  }
  anti_stmt.finalize

  let avg_sql = "SELECT AVG(strength) FROM memories"
  let mut avg_stmt = match db.prepare(avg_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }
  let avg_strength = if avg_stmt.step == SQLITE_ROW {
    avg_stmt.column_double(0)
  } else {
    0.0 as Float64
  }
  avg_stmt.finalize

  Result.Ok(MemoryStats(total: total, active: active, pinned: pinned, anti_pattern: anti_pattern, avg_strength: avg_strength))
}

fn generate_agents_md(db: mut Database, path: String) -> Result[Nil, String] {
  # Get all pinned memories to include in AGENTS.md
  let sql = "SELECT content, tags, scope FROM memories WHERE status = 'pinned' ORDER BY created_at DESC"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  let mut pinned_content = ""
  loop {
    let step_result = stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      stmt.finalize
      return Result.Error("Query failed")
    }
    let content = stmt.column_text(0)
    let tags = stmt.column_text(1)
    let scope = stmt.column_text(2)
    pinned_content = pinned_content + "- " + content + " (tags: " + tags + ", scope: " + scope + ")\n"
  }
  stmt.finalize

  # Get anti-patterns to include as warnings
  let anti_sql = "SELECT content FROM memories WHERE status = 'anti-pattern' ORDER BY harmful_count DESC LIMIT 10"
  let mut anti_stmt = match db.prepare(anti_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  let mut anti_content = ""
  loop {
    let step_result = anti_stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      anti_stmt.finalize
      return Result.Error("Query failed")
    }
    let content = anti_stmt.column_text(0)
    anti_content = anti_content + "- " + content + "\n"
  }
  anti_stmt.finalize

  # Build the AGENTS.md content
  let mut output = "# recalldory Memories\n\n"
  output = output + "Auto-generated by `recalldory agents-md`. Do not edit manually.\n\n"

  if pinned_content != "" {
    output = output + "## Pinned Memories\n\n" + pinned_content + "\n"
  }

  if anti_content != "" {
    output = output + "## Anti-Patterns (Avoid)\n\n" + anti_content + "\n"
  }

  if pinned_content == "" and anti_content == "" {
    output = output + "No pinned memories or anti-patterns found.\n"
  }

  # Write to file at the specified path
  let file_path = "${path}/AGENTS.md".to_path
  match WriteOnlyFile.new(file_path) {
    case Ok(f) -> {
      let mut file = f
      match file.write(output.to_byte_array) {
        case Ok(_) -> {
          let _ = file.flush
          Result.Ok(nil)
        }
        case Error(e) -> Result.Error("Failed to write AGENTS.md: ${e}")
      }
    }
    case Error(e) -> Result.Error("Failed to open AGENTS.md for writing: ${e}")
  }
}

fn export_memories(db: mut Database) -> Result[String, String] {
  let sql = "SELECT id, content, content_hash, summary, tags, scope, status, is_negative, strength, access_count, decay_rate, helpful_count, harmful_count, created_at, updated_at, last_accessed FROM memories ORDER BY created_at DESC"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  let mut result = "{\"memories\": [\n"
  let mut first = true

  loop {
    let step_result = stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      stmt.finalize
      return Result.Error("Query failed")
    }

    if first {
      first = false
    } else {
      result = result + ",\n"
    }

    let id = stmt.column_int(0)
    let content = escape_json(stmt.column_text(1))
    let content_hash = stmt.column_text(2)
    let summary = escape_json(stmt.column_text(3))
    let tags = escape_json(stmt.column_text(4))
    let scope = stmt.column_text(5)
    let status = stmt.column_text(6)
    let is_negative = stmt.column_int(7)
    let strength = stmt.column_double(8)
    let access_count = stmt.column_int(9)
    let decay_rate = stmt.column_double(10)
    let helpful_count = stmt.column_int(11)
    let harmful_count = stmt.column_int(12)
    let created_at = stmt.column_text(13)
    let updated_at = stmt.column_text(14)
    let last_accessed = stmt.column_text(15)

    result = result + "    {\"id\": ${id}, \"content\": \"${content}\", \"content_hash\": \"${content_hash}\", \"summary\": \"${summary}\", \"tags\": \"${tags}\", \"scope\": \"${scope}\", \"status\": \"${status}\", \"is_negative\": ${is_negative}, \"strength\": ${(strength as Float).to_string}, \"access_count\": ${access_count}, \"decay_rate\": ${(decay_rate as Float).to_string}, \"helpful_count\": ${helpful_count}, \"harmful_count\": ${harmful_count}, \"created_at\": \"${created_at}\", \"updated_at\": \"${updated_at}\", \"last_accessed\": \"${last_accessed}\"}"
  }
  stmt.finalize

  result = result + "\n  ], \"exported_at\": \"" + get_timestamp(db) + "\"}"
  Result.Ok(result)
}

fn import_memories(db: mut Database, file: String) -> Result[Int, String] {
  # Read file contents
  let path = file.to_path
  let mut f = match ReadOnlyFile.new(path) {
    case Ok(file) -> file
    case Error(_) -> return Result.Error("Failed to open file: ${file}")
  }

  let mut bytes = ByteArray.new
  let _ = f.read_all(bytes)
  let content = bytes.into_string

  # Create buffer and parse JSON
  let buffer = Buffer.new(content)
  let json = match Json.parse(buffer) {
    case Ok(j) -> j
    case Error(_) -> return Result.Error("Failed to parse JSON")
  }

  # Use Query to access memories array
  let q = json.query
  let memories_q = q.key("memories")

  # Get the array
  let memories = match memories_q.as_array {
    case Some(arr) -> arr
    case None -> return Result.Error("'memories' is not an array")
  }

  let mut count = 0

  for mem in memories.iter {
    # Get content from each memory object
    let content_q = mem.query.key("content")
    let mem_content = match content_q.as_string {
      case Some(s) -> s
      case None -> ""
    }

    if mem_content == "" {
    } else {
      # Extract tags (optional)
      let tags = match mem.query.key("tags").as_string {
        case Some(s) -> s
        case None -> ""
      }

      # Extract scope (optional)
      let scope = match mem.query.key("scope").as_string {
        case Some(s) -> s
        case None -> "project"
      }

      # Extract status (optional)
      let status = match mem.query.key("status").as_string {
        case Some(s) -> s
        case None -> "active"
      }

      let pin = status == "pinned"

      # Insert the memory
      match add_memory(db, mem_content, tags, scope, pin) {
        case Ok(_) -> count = count + 1
        case Error(_) -> { }
      }
    }
  }

  Result.Ok(count)
}

fn get_timestamp(db: mut Database) -> String {
  let sql = "SELECT datetime('now')"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(_) -> return ""
  }

  let result = if stmt.step == SQLITE_ROW {
    stmt.column_text(0)
  } else {
    ""
  }
  stmt.finalize
  result
}

fn sha256_hash(content: String) -> String {
  let bytes = content.to_byte_array
  let mut hash = Sha256.new
  hash.write(bytes)
  hash.finish.to_string
}

# SimHash for near-duplicate detection
# Uses character 3-gram shingles with weighted bit-vector voting
# to produce a locality-sensitive 32-bit hash stored as hex string.
fn simhash(content: String) -> String {
  let bytes = content.to_byte_array
  let size = bytes.size

  if size < 3 {
    # Too short for 3-gram shingling; use SHA256 truncated to 32 bits
    return simhash_substr(sha256_hash(content), 0, 8)
  }

  # Collect all shingle hashes first
  let mut hashes: Array[Int] = []
  let mut i = 0
  while i + 2 < size {
    let b0 = match bytes.get(i) {
      case Ok(b) -> b
      case Error(_) -> 0
    }
    let b1 = match bytes.get(i + 1) {
      case Ok(b) -> b
      case Error(_) -> 0
    }
    let b2 = match bytes.get(i + 2) {
      case Ok(b) -> b
      case Error(_) -> 0
    }

    # Hash this shingle using FNV-1a (32-bit, wrapping)
    let mut h = 2166136261
    h = (h ^ b0).wrapping_mul(16777619)
    h = (h ^ b1).wrapping_mul(16777619)
    h = (h ^ b2).wrapping_mul(16777619)
    hashes.push(h)

    i = i + 1
  }

  # For each bit position, count votes across all shingle hashes
  let mut result = 0
  let mut bit = 0
  while bit < 32 {
    let mut count = 0
    for h in hashes.iter {
      if (h >> bit) & 1 == 1 {
        count = count + 1
      } else {
        count = count - 1
      }
    }
    if count > 0 {
      result = result | (1 << bit)
    }
    bit = bit + 1
  }

  int_to_hex(result)
}

# Simple integer to hex conversion
fn int_to_hex(val: Int) -> String {
  let hex_chars = "0123456789abcdef".to_byte_array
  let mut result = StringBuffer.new

  # Handle 8 hex digits (32 bits)
  let mut shift = 28
  let v = val & 0xFFFFFFFF

  while shift >= 0 {
    let nibble = (v >> shift) & 15
    match hex_chars.get(nibble) {
      case Ok(byte) -> {
        let mut single = ByteArray.new
        single.push(byte)
        result.push(single.into_string)
      }
      case Error(_) -> result.push("0")
    }
    shift = shift - 4
  }

  result.into_string
}

# Parse hex string to Int
fn hex_to_int(hex: String) -> Int {
  let bytes = hex.to_byte_array
  let mut result = 0

  for byte in bytes.iter {
    let nibble = if byte >= 48 and byte <= 57 {
      byte - 48
    } else if byte >= 97 and byte <= 102 {
      byte - 87
    } else if byte >= 65 and byte <= 70 {
      byte - 55
    } else {
      0
    }
    result = (result << 4) + nibble
  }

  result
}

# Calculate Hamming distance between two hash values
fn hamming_distance(a: Int, b: Int) -> Int {
  let val = (a & 0xFFFFFFFF) ^ (b & 0xFFFFFFFF)
  let mut count = 0
  let mut v = val

  while v > 0 {
    count = count + (v & 1)
    v = v >> 1
  }

  count
}

# Check if content contradicts existing memories
# Returns tuple of (is_contradiction, contradicts_id)
fn check_contradiction(db: mut Database, content: String) -> (Bool, Option[Int]) {
  let content_lower = to_lowercase(content)
  let content_bytes = content_lower.to_byte_array

  # Extract key entities (words > 3 chars, not common words)
  let entities = extract_entities(ref content_bytes)
  if entities.size == 0 {
    return (false, Option.None)
  }

  # Check if new content has negation
  let has_negation = has_negation_words(ref content_bytes)

  # Search for memories with similar entities
  let search_sql = "SELECT id, content FROM memories WHERE status = 'active'"
  let mut stmt = match db.prepare(search_sql) {
    case Ok(s) -> s
    case Error(_) -> return (false, Option.None)
  }

  loop {
    let step_result = stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      break
    }

    let mem_id = stmt.column_int(0)
    let mem_content = stmt.column_text(1)
    let mem_lower = to_lowercase(mem_content)
    let mem_bytes = mem_lower.to_byte_array

    # Check for entity overlap
    let mem_entities = extract_entities(ref mem_bytes)
    let overlap_count = count_entity_overlap(ref entities, ref mem_entities)

    # Need significant entity overlap for contradiction
    if overlap_count >= 2 {
      let mem_has_negation = has_negation_words(ref mem_bytes)

      # Contradiction: one has negation, other doesn't
      if has_negation != mem_has_negation {
        stmt.finalize
        return (true, Option.Some(mem_id))
      }
    }
  }
  stmt.finalize

  (false, Option.None)
}

fn to_lowercase(s: String) -> String {
  let bytes = s.to_byte_array
  let mut result = ByteArray.new

  for byte in bytes.iter {
    if byte >= 65 and byte <= 90 {
      # Convert uppercase to lowercase by adding 32 to ASCII value
      result.push(byte + 32)
    } else {
      result.push(byte)
    }
  }
  result.into_string
}

fn extract_entities(bytes: ref ByteArray) -> Array[String] {
  let mut entities: Array[String] = []
  let mut word_bytes: ByteArray = ByteArray.new
  let mut in_word = false

  for byte in bytes.iter {
    let is_alphanum = (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)

    if is_alphanum {
      word_bytes.push(byte)
      in_word = true
    } else if in_word {
      if word_bytes.size > 3 {
        # Convert bytes to string
        let word_str = word_bytes.clone.into_string

        # Check if not a common word
        let mut is_common = false
        for common in COMMON_WORDS.iter {
          if word_str == common {
            is_common = true
          }
        }

        if !is_common {
          entities.push(word_str)
        }
      }
      word_bytes = ByteArray.new
      in_word = false
    }
  }

  # Handle last word
  if in_word and word_bytes.size > 3 {
    let word_str = word_bytes.clone.into_string

    let mut is_common = false
    for common in COMMON_WORDS.iter {
      if word_str == common {
        is_common = true
      }
    }

    if !is_common {
      entities.push(word_str)
    }
  }

  entities
}

fn has_negation_words(bytes: ref ByteArray) -> Bool {
  let mut word_bytes: ByteArray = ByteArray.new
  let mut in_word = false

  for byte in bytes.iter {
    let is_alphanum = (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)

    if is_alphanum {
      word_bytes.push(byte)
      in_word = true
    } else if in_word {
      # Convert bytes to string
      let word_str = word_bytes.clone.into_string

      # Check against negation words
      for neg in NEGATION_WORDS.iter {
        if word_str == neg {
          return true
        }
      }

      word_bytes = ByteArray.new
      in_word = false
    }
  }

  # Check last word
  if in_word {
    let word_str = word_bytes.clone.into_string

    for neg in NEGATION_WORDS.iter {
      if word_str == neg {
        return true
      }
    }
  }

  false
}

fn count_entity_overlap(entities1: ref Array[String], entities2: ref Array[String]) -> Int {
  let mut count = 0
  for e1 in entities1.iter {
    for e2 in entities2.iter {
      if e1 == e2 {
        count = count + 1
      }
    }
  }
  count
}

type pub Memory {
  let @id: Int
  let @content: String
  let @content_hash: String
  let @summary: String
  let @tags: String
  let @scope: String
  let @status: String
  let @xflag: Bool
  let @strength: Float64
  let @access_count: Int
  let @decay_rate: Float64
  let @helpful_count: Int
  let @harmful_count: Int
  let @created_at: String
  let @updated_at: String
  let @last_accessed: String
  let @similarity: Float64
  let @parent_id: Option[Int]
  let @contradicts_id: Option[Int]
  let @storage_strength: Float64
  let @retrieval_strength: Float64
  let @is_contradiction: Bool
}

impl Memory{
  fn pub static from_row(stmt: ref Statement) -> Memory{
    Memory(
      id: stmt.column_int(0),
      content: stmt.column_text(1),
      content_hash: stmt.column_text(2),
      summary: stmt.column_text(3),
      tags: stmt.column_text(4),
      scope: stmt.column_text(5),
      status: stmt.column_text(6),
      xflag: stmt.column_int(7) == 1,
      strength: stmt.column_double(8),
      access_count: stmt.column_int(9),
      decay_rate: stmt.column_double(10),
      helpful_count: stmt.column_int(11),
      harmful_count: stmt.column_int(12),
      created_at: stmt.column_text(13),
      updated_at: stmt.column_text(14),
      last_accessed: stmt.column_text(15),
      similarity: 0.0 as Float64,
      parent_id: Option.None,
      contradicts_id: Option.None,
      storage_strength: 0.1 as Float64,
      retrieval_strength: 1.0 as Float64,
      is_contradiction: false
    )
  }

  fn pub static from_row_with_score(stmt: ref Statement) -> Memory{
    Memory(
      id: stmt.column_int(0),
      content: stmt.column_text(1),
      content_hash: stmt.column_text(2),
      summary: stmt.column_text(3),
      tags: stmt.column_text(4),
      scope: stmt.column_text(5),
      status: stmt.column_text(6),
      xflag: stmt.column_int(7) == 1,
      strength: stmt.column_double(8),
      access_count: stmt.column_int(9),
      decay_rate: stmt.column_double(10),
      helpful_count: stmt.column_int(11),
      harmful_count: stmt.column_int(12),
      created_at: stmt.column_text(13),
      updated_at: stmt.column_text(14),
      last_accessed: stmt.column_text(15),
      similarity: stmt.column_double(16),
      parent_id: Option.None,
      contradicts_id: Option.None,
      storage_strength: 0.1 as Float64,
      retrieval_strength: 1.0 as Float64,
      is_contradiction: false
    )
  }

  fn pub static from_row_with_parent(stmt: ref Statement) -> Memory{
    let parent = stmt.column_int(16)
    Memory(
      id: stmt.column_int(0),
      content: stmt.column_text(1),
      content_hash: stmt.column_text(2),
      summary: stmt.column_text(3),
      tags: stmt.column_text(4),
      scope: stmt.column_text(5),
      status: stmt.column_text(6),
      xflag: stmt.column_int(7) == 1,
      strength: stmt.column_double(8),
      access_count: stmt.column_int(9),
      decay_rate: stmt.column_double(10),
      helpful_count: stmt.column_int(11),
      harmful_count: stmt.column_int(12),
      created_at: stmt.column_text(13),
      updated_at: stmt.column_text(14),
      last_accessed: stmt.column_text(15),
      similarity: 0.0 as Float64,
      parent_id: if parent > 0 { Option.Some(parent) } else { Option.None },
      contradicts_id: Option.None,
      storage_strength: 0.1 as Float64,
      retrieval_strength: 1.0 as Float64,
      is_contradiction: false
    )
  }

  fn pub static from_row_with_contradicts(stmt: ref Statement) -> Memory{
    let contradicts = stmt.column_int(16)
    Memory(
      id: stmt.column_int(0),
      content: stmt.column_text(1),
      content_hash: stmt.column_text(2),
      summary: stmt.column_text(3),
      tags: stmt.column_text(4),
      scope: stmt.column_text(5),
      status: stmt.column_text(6),
      xflag: stmt.column_int(7) == 1,
      strength: stmt.column_double(8),
      access_count: stmt.column_int(9),
      decay_rate: stmt.column_double(10),
      helpful_count: stmt.column_int(11),
      harmful_count: stmt.column_int(12),
      created_at: stmt.column_text(13),
      updated_at: stmt.column_text(14),
      last_accessed: stmt.column_text(15),
      similarity: 0.0 as Float64,
      parent_id: Option.None,
      contradicts_id: if contradicts > 0 { Option.Some(contradicts) } else { Option.None },
      storage_strength: 0.1 as Float64,
      retrieval_strength: 1.0 as Float64,
      is_contradiction: true
    )
  }
}

fn output_memories(memories: Array[Memory], out: Stdout) {
  let mut first = true
  out.print("{\"results\": [")

  for memory in memories.iter {
    if first {
      first = false
    } else {
      out.print(",")
    }

    let neg_val = if memory.xflag { "true" } else { "false" }
    # Use similarity if available (from search), otherwise use strength
    let score = if (memory.similarity as Float) > 0.0 { memory.similarity } else { memory.strength }
    out.print("{\"id\": ${memory.id}, \"summary\": \"${escape_json(memory.content)}\", \"score\": ${(score as Float).to_string}, \"tags\": \"${escape_json(memory.tags)}\", \"status\": \"${memory.status}\", \"negative_flag\": ${neg_val}}")
  }

  out.print("]}")
}

fn escape_json(s: String) -> String{
  let hex_chars = "0123456789abcdef".to_byte_array
  let bytes = s.to_byte_array
  let mut result = ByteArray.new

  for byte in bytes.iter {
    if byte == 34 {
      # " (double quote)
      result.push(92)
      result.push(34)
    } else if byte == 92 {
      # \ (backslash)
      result.push(92)
      result.push(92)
    } else if byte == 10 {
      # \n
      result.push(92)
      result.push(110)
    } else if byte == 13 {
      # \r
      result.push(92)
      result.push(114)
    } else if byte == 9 {
      # \t
      result.push(92)
      result.push(116)
    } else if byte == 8 {
      # \b (backspace)
      result.push(92)
      result.push(98)
    } else if byte == 12 {
      # \f (form feed)
      result.push(92)
      result.push(102)
    } else if byte < 32 {
      # Other control characters: \u00XX
      result.push(92)   # \
      result.push(117)   # u
      result.push(48)    # 0
      result.push(48)    # 0
      let hi = (byte >> 4) & 15
      let lo = byte & 15
      match hex_chars.get(hi) {
        case Ok(h) -> result.push(h)
        case Error(_) -> result.push(48)
      }
      match hex_chars.get(lo) {
        case Ok(l) -> result.push(l)
        case Error(_) -> result.push(48)
      }
    } else {
      result.push(byte)
    }
  }

  result.into_string
}

fn output_history(memories: Array[Memory], out: Stdout) {
  let mut first = true
  out.print("{\"versions\": [")

  for memory in memories.iter {
    if first {
      first = false
    } else {
      out.print(",")
    }

    let parent_str = match memory.parent_id {
      case Some(pid) -> "\"${pid}\""
      case None -> "null"
    }

    out.print("{\"id\": ${memory.id}, \"content\": \"${escape_json(memory.content)}\", \"status\": \"${memory.status}\", \"parent_id\": ${parent_str}, \"created_at\": \"${memory.created_at}\"}")
  }

  out.print("]}")
}

fn output_contradictions(memories: Array[Memory], out: Stdout) {
  let mut first = true
  out.print("{\"contradictions\": [")

  for memory in memories.iter {
    if first {
      first = false
    } else {
      out.print(",")
    }

    let contradicts_str = match memory.contradicts_id {
      case Some(cid) -> "\"${cid}\""
      case None -> "null"
    }

    out.print("{\"id\": ${memory.id}, \"content\": \"${escape_json(memory.content)}\", \"contradicts_id\": ${contradicts_str}, \"created_at\": \"${memory.created_at}\"}")
  }

  out.print("]}")
}
