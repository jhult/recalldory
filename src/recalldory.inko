import cli (parse_args, Command, ParsedArgs)
import db (Database, Statement, init_schema, SQLITE_ROW, SQLITE_DONE)
import std.env
import std.stdio (Stdout)
import std.string (StringBuffer, IntoString)
import std.crypto.sha2 (Sha256)
import std.json (Json)
import std.fs.file (ReadOnlyFile)
import std.bytes (ByteArray)
import std.io (Buffer)

type async Main {
  fn async main {
    let out = Stdout.new

    match parse_args {
      case Some(parsed) -> {
        let global = parsed.global
        match open_database(global) {
          case Ok(db) -> {
            let mut database = db
            handle_command(parsed.into_command, database, out)
            database.close
          }
          case Error(e) -> {
            out.print("{\"error\": \"${e}\"}")
          }
        }
      }
      case None -> {
        out.print("{\"error\": \"No command provided\"}")
      }
    }
  }
}

fn open_database(global: Bool) -> Result[Database, String] {
  let path = if global {
    let home = match env.get("HOME") {
      case Ok(h) -> h
      case Error(_) -> return Result.Error("HOME not set")
    }
    let dir = "${home}/.recalldory".to_path
    dir.create_directory
    "${home}/.recalldory/memory.db"
  } else {
    let dir = ".recalldory".to_path
    dir.create_directory
    "./.recalldory/memory.db"
  }

  let db = match Database.new(path) {
    case Ok(d) -> d
    case Error(e) -> return Result.Error("Failed to open database: ${e}")
  }

  match init_schema(db) {
    case Error(e) -> {
      db.close
      return Result.Error("Failed to initialize schema: ${e}")
    }
    case Ok(_) -> { }
  }

  Result.Ok(db)
}

fn handle_command(cmd: Command, db: mut Database, out: Stdout) {
  match cmd {
    case Add(content, tags, scope, pin) -> {
      match add_memory(db, content, tags, scope, pin) {
        case Ok(id) -> {
          out.print("{\"success\": true, \"id\": ${id}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Recall(query, budget, expand, full_id, scope, top) -> {
      match search_memories(db, query, scope, top) {
        case Ok(mems) -> {
          output_memories(mems, out)
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case List(scope, status, limit) -> {
      match list_memories(db, scope, status, limit) {
        case Ok(mems) -> {
          output_memories(mems, out)
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Forget(id) -> {
      match forget_memory(db, id) {
        case Ok(deleted) -> {
          out.print("{\"success\": ${deleted}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Pin(id) -> {
      match pin_memory(db, id) {
        case Ok(pinned) -> {
          out.print("{\"success\": ${pinned}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Unpin(id) -> {
      match unpin_memory(db, id) {
        case Ok(unpinned) -> {
          out.print("{\"success\": ${unpinned}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Feedback(id, feedback_type) -> {
      match feedback_memory(db, id, feedback_type) {
        case Ok(updated) -> {
          out.print("{\"success\": ${updated}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Maintain(dry_run) -> {
      match maintain_memory(db, dry_run) {
        case Ok(stats) -> {
          out.print("{\"decayed\": ${stats.decayed}, \"anti_patterns\": ${stats.anti_patterns}, \"pruned\": ${stats.pruned}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Export -> {
      match export_memories(db) {
        case Ok(json) -> {
          out.print(json)
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Import(file) -> {
      match import_memories(db, file) {
        case Ok(count) -> {
          out.print("{\"success\": true, \"imported\": ${count}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case AgentsMd(path) -> {
      match generate_agents_md(db, path) {
        case Ok(_) -> {
          out.print("{\"success\": true}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
    case Stats(verbose) -> {
      match get_stats(db, verbose) {
        case Ok(stats) -> {
          out.print("{\"total\": ${stats.total}, \"active\": ${stats.active}, \"pinned\": ${stats.pinned}, \"anti_pattern\": ${stats.anti_pattern}, \"avg_strength\": ${(stats.avg_strength as Float).to_string}}")
        }
        case Error(e) -> {
          out.print("{\"error\": \"${e}\"}")
        }
      }
    }
  }
}

fn add_memory(db: mut Database, content: String, tags: String, scope: String, pin: Bool) -> Result[Int, String] {
  let hash = sha256_hash(content)
  let status = if pin { "pinned" } else { "active" }

  let check_sql = "SELECT id, access_count FROM memories WHERE content_hash = ?"
  let mut stmt = match db.prepare(check_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_text(1, hash) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let mut existing_id: Option[Int] = Option.None
  let mut existing_count = 0

  if stmt.step == SQLITE_ROW {
    existing_id = Option.Some(stmt.column_int(0))
    existing_count = stmt.column_int(1)
  }
  stmt.finalize

  match existing_id {
    case Some(id) -> {
      let update_sql = "UPDATE memories SET access_count = ?, last_accessed = datetime('now') WHERE id = ?"
      let mut update_stmt = match db.prepare(update_sql) {
        case Ok(s) -> s
        case Error(e) -> return Result.Error("Failed to prepare: ${e}")
      }
      match update_stmt.bind_int(1, existing_count + 1) {
        case Error(e) -> {
          update_stmt.finalize
          return Result.Error("Failed to bind: ${e}")
        }
        case Ok(_) -> { }
      }
      match update_stmt.bind_int(2, id) {
        case Error(e) -> {
          update_stmt.finalize
          return Result.Error("Failed to bind: ${e}")
        }
        case Ok(_) -> { }
      }
      let _ = update_stmt.step
      update_stmt.finalize
      return Result.Ok(id)
    }
    case None -> { }
  }

  let insert_sql = "INSERT INTO memories (content, content_hash, tags, scope, status) VALUES (?, ?, ?, ?, ?)"
  let mut insert_stmt = match db.prepare(insert_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match insert_stmt.bind_text(1, content) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(2, hash) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(3, tags) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(4, scope) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }
  match insert_stmt.bind_text(5, status) {
    case Error(e) -> {
      insert_stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let result = insert_stmt.step
  insert_stmt.finalize

  if result != SQLITE_DONE {
    return Result.Error("Insert failed")
  }

  let memory_id = db.last_insert_rowid as Int

  # Index in FTS5 (rowid will match memory id)
  let fts_sql = "INSERT INTO memories_fts (content, tags, summary) VALUES (?, ?, ?)"
  let mut fts_stmt = match db.prepare(fts_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare FTS: ${e}")
  }

  match fts_stmt.bind_text(1, content) {
    case Error(e) -> {
      fts_stmt.finalize
      return Result.Error("Failed to bind FTS: ${e}")
    }
    case Ok(_) -> { }
  }
  match fts_stmt.bind_text(2, tags) {
    case Error(e) -> {
      fts_stmt.finalize
      return Result.Error("Failed to bind FTS: ${e}")
    }
    case Ok(_) -> { }
  }
  match fts_stmt.bind_text(3, "") {
    case Error(e) -> {
      fts_stmt.finalize
      return Result.Error("Failed to bind FTS: ${e}")
    }
    case Ok(_) -> { }
  }

  let fts_result = fts_stmt.step
  fts_stmt.finalize

  if fts_result != SQLITE_DONE {
    return Result.Error("FTS indexing failed")
  }

  Result.Ok(memory_id)
}

fn list_memories(db: mut Database, scope_filter: String, status_filter: String, limit: Int) -> Result[Array[Memory], String] {
  let mut sql = "SELECT id, content, content_hash, summary, tags, scope, status, is_negative, strength, access_count, decay_rate, helpful_count, harmful_count, created_at, updated_at, last_accessed FROM memories WHERE 1=1"

  if scope_filter != "" {
    sql = sql + " AND scope = ?"
  }
  if status_filter != ""{
    sql = sql + " AND status = ?"
  }

  sql = sql + " ORDER BY last_accessed DESC LIMIT ?"

  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  let mut idx = 1
  if scope_filter != "" {
    match stmt.bind_text(idx, scope_filter) {
      case Error(e) -> {
        stmt.finalize
        return Result.Error("Failed to bind: ${e}")
      }
      case Ok(_) -> { }
    }
    idx = idx + 1
  }
  if status_filter != ""{
    match stmt.bind_text(idx, status_filter) {
      case Error(e) -> {
        stmt.finalize
        return Result.Error("Failed to bind: ${e}")
      }
      case Ok(_) -> { }
    }
    idx = idx + 1
  }
  match stmt.bind_int(idx, limit) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let mut results = []
  loop {
    let step_result = stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      stmt.finalize
      return Result.Error("Query failed")
    }
    results.push(Memory.from_row(ref stmt))
  }
  stmt.finalize

  Result.Ok(results)
}

fn search_memories(db: mut Database, query: String, scope_filter: String, limit: Int) -> Result[Array[Memory], String] {
  # Use FTS5 for full-text search with bm25 ranking
  # Include bm25 score for combined scoring
  let mut sql = "SELECT m.id, m.content, m.content_hash, m.summary, m.tags, m.scope, m.status, m.is_negative, m.strength, m.access_count, m.decay_rate, m.helpful_count, m.harmful_count, m.created_at, m.updated_at, m.last_accessed, bm25(memories_fts) as similarity_score FROM memories m JOIN memories_fts fts ON m.id = fts.rowid WHERE memories_fts MATCH ?"

  if scope_filter != "" {
    sql = sql + " AND m.scope = ?"
  }

  sql = sql + " ORDER BY bm25(memories_fts) LIMIT ?"

  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_text(1, query) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let mut idx = 2
  if scope_filter != "" {
    match stmt.bind_text(idx, scope_filter) {
      case Error(e) -> {
        stmt.finalize
        return Result.Error("Failed to bind: ${e}")
      }
      case Ok(_) -> { }
    }
    idx = idx + 1
  }
  match stmt.bind_int(idx, limit) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let mut results = []
  loop {
    let step_result = stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      stmt.finalize
      return Result.Error("Query failed")
    }
    results.push(Memory.from_row_with_score(ref stmt))
  }
  stmt.finalize

  Result.Ok(results)
}

fn forget_memory(db: mut Database, id: Int) -> Result[Bool, String] {
  let sql = "DELETE FROM memories WHERE id = ?"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_int(1, id) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let _ = stmt.step
  stmt.finalize

  Result.Ok(db.changes > 0)
}

fn pin_memory(db: mut Database, id: Int) -> Result[Bool, String] {
  let sql = "UPDATE memories SET status = 'pinned', updated_at = datetime('now') WHERE id = ? AND status != 'pinned'"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_int(1, id) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let _ = stmt.step
  stmt.finalize
  Result.Ok(db.changes > 0)
}

fn unpin_memory(db: mut Database, id: Int) -> Result[Bool, String]{
  let sql = "UPDATE memories SET status = 'active', updated_at = datetime('now') WHERE id = ? AND status = 'pinned'"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_int(1, id) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let _ = stmt.step
  stmt.finalize
  Result.Ok(db.changes > 0)
}

fn feedback_memory(db: mut Database, id: Int, feedback_type: String) -> Result[Bool, String] {
  let column = if feedback_type == "helpful" { "helpful_count" } else { "harmful_count" }
  let sql = "UPDATE memories SET ${column} = ${column} + 1, updated_at = datetime('now') WHERE id = ?"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  match stmt.bind_int(1, id) {
    case Error(e) -> {
      stmt.finalize
      return Result.Error("Failed to bind: ${e}")
    }
    case Ok(_) -> { }
  }

  let _ = stmt.step
  stmt.finalize
  Result.Ok(db.changes > 0)
}

type pub MaintainStats {
  let @decayed: Int
  let @anti_patterns: Int
  let @pruned: Int
}

fn maintain_memory(db: mut Database, dry_run: Bool) -> Result[MaintainStats, String] {
  let mut decayed = 0
  let mut anti_patterns = 0
  let mut pruned = 0

  # Decay: reduce strength based on time since last access
  # strength = strength * (1 - decay_rate * hours_since_access)
  let decay_sql = "UPDATE memories SET strength = MAX(0.0, strength * (1 - decay_rate * (julianday('now') - julianday(last_accessed)) * 24)), updated_at = datetime('now') WHERE status != 'pinned' AND strength > 0.05"
  if !dry_run {
    let mut decay_stmt = match db.prepare(decay_sql) {
      case Ok(s) -> s
      case Error(e) -> return Result.Error("Failed to prepare decay: ${e}")
    }
    let _ = decay_stmt.step
    decayed = db.changes
    decay_stmt.finalize
  }

  # Mark anti-pattern memories (harmful_count >= 3)
  let anti_sql = "UPDATE memories SET status = 'anti-pattern', is_negative = 1, updated_at = datetime('now') WHERE harmful_count >= 3 AND status != 'pinned' AND status != 'anti-pattern'"
  if !dry_run {
    let mut anti_stmt = match db.prepare(anti_sql) {
      case Ok(s) -> s
      case Error(e) -> return Result.Error("Failed to prepare anti-pattern: ${e}")
    }
    let _ = anti_stmt.step
    anti_patterns = db.changes
    anti_stmt.finalize
  }

  # Prune low-strength unpinned memories
  let prune_sql = "DELETE FROM memories WHERE status != 'pinned' AND strength < 0.05"
  if !dry_run {
    let mut prune_stmt = match db.prepare(prune_sql) {
      case Ok(s) -> s
      case Error(e) -> return Result.Error("Failed to prepare prune: ${e}")
    }
    let _ = prune_stmt.step
    pruned = db.changes
    prune_stmt.finalize

    # Also delete from FTS
    # Note: SQLite doesn't support DELETE with JOIN in the same way,
    # but since we use standalone FTS table, we need to clean up separately
    # For now, we rely on the fact that pruned memories won't match searches
  }

  Result.Ok(MaintainStats(decayed: decayed, anti_patterns: anti_patterns, pruned: pruned))
}

type pub MemoryStats {
  let @total: Int
  let @active: Int
  let @pinned: Int
  let @anti_pattern: Int
  let @avg_strength: Float64
}

fn get_stats(db: mut Database, verbose: Bool) -> Result[MemoryStats, String] {
  let total_sql = "SELECT COUNT(*) FROM memories"
  let mut total_stmt = match db.prepare(total_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }
  let total = if total_stmt.step == SQLITE_ROW {
    total_stmt.column_int(0)
  } else {
    0
  }
  total_stmt.finalize

  let active_sql = "SELECT COUNT(*) FROM memories WHERE status = 'active'"
  let mut active_stmt = match db.prepare(active_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }
  let active = if active_stmt.step == SQLITE_ROW {
    active_stmt.column_int(0)
  } else {
    0
  }
  active_stmt.finalize

  let pinned_sql = "SELECT COUNT(*) FROM memories WHERE status = 'pinned'"
  let mut pinned_stmt = match db.prepare(pinned_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }
  let pinned = if pinned_stmt.step == SQLITE_ROW {
    pinned_stmt.column_int(0)
  } else {
    0
  }
  pinned_stmt.finalize

  let anti_sql = "SELECT COUNT(*) FROM memories WHERE status = 'anti-pattern'"
  let mut anti_stmt = match db.prepare(anti_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }
  let anti_pattern = if anti_stmt.step == SQLITE_ROW {
    anti_stmt.column_int(0)
  } else {
    0
  }
  anti_stmt.finalize

  let avg_sql = "SELECT AVG(strength) FROM memories"
  let mut avg_stmt = match db.prepare(avg_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }
  let avg_strength = if avg_stmt.step == SQLITE_ROW {
    avg_stmt.column_double(0)
  } else {
    0.0 as Float64
  }
  avg_stmt.finalize

  Result.Ok(MemoryStats(total: total, active: active, pinned: pinned, anti_pattern: anti_pattern, avg_strength: avg_strength))
}

fn generate_agents_md(db: mut Database, path: String) -> Result[Nil, String] {
  # Get all pinned memories to include in AGENTS.md
  let sql = "SELECT content, tags, scope FROM memories WHERE status = 'pinned' ORDER BY created_at DESC"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  let mut pinned_content = ""
  loop {
    let step_result = stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      stmt.finalize
      return Result.Error("Query failed")
    }
    let content = stmt.column_text(0)
    let tags = stmt.column_text(1)
    let scope = stmt.column_text(2)
    pinned_content = pinned_content + "- " + content + " (tags: " + tags + ", scope: " + scope + ")\n"
  }
  stmt.finalize

  # Get anti-patterns to include as warnings
  let anti_sql = "SELECT content FROM memories WHERE status = 'anti-pattern' ORDER BY harmful_count DESC LIMIT 10"
  let mut anti_stmt = match db.prepare(anti_sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  let mut anti_content = ""
  loop {
    let step_result = anti_stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      anti_stmt.finalize
      return Result.Error("Query failed")
    }
    let content = anti_stmt.column_text(0)
    anti_content = anti_content + "- " + content + "\n"
  }
  anti_stmt.finalize

  # Build the AGENTS.md content
  let mut output = "# recalldory Memories\n\n"
  output = output + "Auto-generated by `recalldory agents-md`. Do not edit manually.\n\n"

  if pinned_content != "" {
    output = output + "## Pinned Memories\n\n" + pinned_content + "\n"
  }

  if anti_content != "" {
    output = output + "## Anti-Patterns (Avoid)\n\n" + anti_content + "\n"
  }

  if pinned_content == "" and anti_content == "" {
    output = output + "No pinned memories or anti-patterns found.\n"
  }

  # Write to file at the specified path
  let file_path = "${path}/AGENTS.md".to_path
  match WriteOnlyFile.new(file_path) {
    case Ok(f) -> {
      let mut file = f
      match file.write(output.to_byte_array) {
        case Ok(_) -> {
          let _ = file.flush
          Result.Ok(nil)
        }
        case Error(e) -> Result.Error("Failed to write AGENTS.md: ${e}")
      }
    }
    case Error(e) -> Result.Error("Failed to open AGENTS.md for writing: ${e}")
  }
}

fn export_memories(db: mut Database) -> Result[String, String] {
  let sql = "SELECT id, content, content_hash, summary, tags, scope, status, is_negative, strength, access_count, decay_rate, helpful_count, harmful_count, created_at, updated_at, last_accessed FROM memories ORDER BY created_at DESC"
  let mut stmt = match db.prepare(sql) {
    case Ok(s) -> s
    case Error(e) -> return Result.Error("Failed to prepare: ${e}")
  }

  let mut result = "{\"memories\": [\n"
  let mut first = true

  loop {
    let step_result = stmt.step
    if step_result == SQLITE_DONE {
      break
    }
    if step_result != SQLITE_ROW {
      stmt.finalize
      return Result.Error("Query failed")
    }

    if first {
      first = false
    } else {
      result = result + ",\n"
    }

    let id = stmt.column_int(0)
    let content = escape_json(stmt.column_text(1))
    let content_hash = stmt.column_text(2)
    let summary = escape_json(stmt.column_text(3))
    let tags = escape_json(stmt.column_text(4))
    let scope = stmt.column_text(5)
    let status = stmt.column_text(6)
    let is_negative = stmt.column_int(7)
    let strength = stmt.column_double(8)
    let access_count = stmt.column_int(9)
    let decay_rate = stmt.column_double(10)
    let helpful_count = stmt.column_int(11)
    let harmful_count = stmt.column_int(12)
    let created_at = stmt.column_text(13)
    let updated_at = stmt.column_text(14)
    let last_accessed = stmt.column_text(15)

    result = result + "    {\"id\": ${id}, \"content\": \"${content}\", \"content_hash\": \"${content_hash}\", \"summary\": \"${summary}\", \"tags\": \"${tags}\", \"scope\": \"${scope}\", \"status\": \"${status}\", \"is_negative\": ${is_negative}, \"strength\": ${(strength as Float).to_string}, \"access_count\": ${access_count}, \"decay_rate\": ${(decay_rate as Float).to_string}, \"helpful_count\": ${helpful_count}, \"harmful_count\": ${harmful_count}, \"created_at\": \"${created_at}\", \"updated_at\": \"${updated_at}\", \"last_accessed\": \"${last_accessed}\"}"
  }
  stmt.finalize

  result = result + "\n  ], \"exported_at\": \"" + get_timestamp + "\"}"
  Result.Ok(result)
}

fn import_memories(db: mut Database, file: String) -> Result[Int, String] {
  # Read file contents
  let path = file.to_path
  let mut f = match ReadOnlyFile.new(path) {
    case Ok(file) -> file
    case Error(_) -> return Result.Error("Failed to open file: ${file}")
  }

  let mut bytes = ByteArray.new
  let _ = f.read_all(bytes)
  let content = bytes.into_string

  # Create buffer and parse JSON
  let buffer = Buffer.new(content)
  let json = match Json.parse(buffer) {
    case Ok(j) -> j
    case Error(_) -> return Result.Error("Failed to parse JSON")
  }

  # Use Query to access memories array
  let q = json.query
  let memories_q = q.key("memories")

  # Get the array
  let memories = match memories_q.as_array {
    case Some(arr) -> arr
    case None -> return Result.Error("'memories' is not an array")
  }

  let mut count = 0

  for mem in memories.iter {
    # Get content from each memory object
    let content_q = mem.query.key("content")
    let mem_content = match content_q.as_string {
      case Some(s) -> s
      case None -> ""
    }

    if mem_content == "" {
    } else {
      # Extract tags (optional)
      let tags = match mem.query.key("tags").as_string {
        case Some(s) -> s
        case None -> ""
      }

      # Extract scope (optional)
      let scope = match mem.query.key("scope").as_string {
        case Some(s) -> s
        case None -> "project"
      }

      # Extract status (optional)
      let status = match mem.query.key("status").as_string {
        case Some(s) -> s
        case None -> "active"
      }

      let pin = status == "pinned"

      # Insert the memory
      match add_memory(db, mem_content, tags, scope, pin) {
        case Ok(_) -> count = count + 1
        case Error(_) -> { }
      }
    }
  }

  Result.Ok(count)
}

fn get_timestamp -> String {
  # Return current timestamp in ISO format
  # Using SQLite's datetime function to get consistent format
  "datetime('now')"
}

fn sha256_hash(content: String) -> String {
  let bytes = content.to_byte_array
  let mut hash = Sha256.new
  hash.write(bytes)
  hash.finish.to_string
}

type pub Memory {
  let @id: Int
  let @content: String
  let @content_hash: String
  let @summary: String
  let @tags: String
  let @scope: String
  let @status: String
  let @xflag: Bool
  let @strength: Float64
  let @access_count: Int
  let @decay_rate: Float64
  let @helpful_count: Int
  let @harmful_count: Int
  let @created_at: String
  let @updated_at: String
  let @last_accessed: String
  let @similarity: Float64
}

impl Memory{
  fn pub static from_row(stmt: ref Statement) -> Memory{
    Memory(
      id: stmt.column_int(0),
      content: stmt.column_text(1),
      content_hash: stmt.column_text(2),
      summary: stmt.column_text(3),
      tags: stmt.column_text(4),
      scope: stmt.column_text(5),
      status: stmt.column_text(6),
      xflag: stmt.column_int(7) == 1,
      strength: stmt.column_double(8),
      access_count: stmt.column_int(9),
      decay_rate: stmt.column_double(10),
      helpful_count: stmt.column_int(11),
      harmful_count: stmt.column_int(12),
      created_at: stmt.column_text(13),
      updated_at: stmt.column_text(14),
      last_accessed: stmt.column_text(15),
      similarity: 0.0 as Float64
    )
  }

  fn pub static from_row_with_score(stmt: ref Statement) -> Memory{
    Memory(
      id: stmt.column_int(0),
      content: stmt.column_text(1),
      content_hash: stmt.column_text(2),
      summary: stmt.column_text(3),
      tags: stmt.column_text(4),
      scope: stmt.column_text(5),
      status: stmt.column_text(6),
      xflag: stmt.column_int(7) == 1,
      strength: stmt.column_double(8),
      access_count: stmt.column_int(9),
      decay_rate: stmt.column_double(10),
      helpful_count: stmt.column_int(11),
      harmful_count: stmt.column_int(12),
      created_at: stmt.column_text(13),
      updated_at: stmt.column_text(14),
      last_accessed: stmt.column_text(15),
      similarity: stmt.column_double(16)
    )
  }
}

fn output_memories(memories: Array[Memory], out: Stdout) {
  let mut first = true
  out.print("{\"results\": [")

  for memory in memories.iter {
    if first {
      first = false
    } else {
      out.print(",")
    }

    let neg_val = if memory.xflag { "true" } else { "false" }
    # Use similarity if available (from search), otherwise use strength
    let score = if (memory.similarity as Float) > 0.0 { memory.similarity } else { memory.strength }
    out.print("{\"id\": ${memory.id}, \"summary\": \"${escape_json(memory.content)}\", \"score\": ${(score as Float).to_string}, \"tags\": \"${escape_json(memory.tags)}\", \"status\": \"${memory.status}\", \"negative_flag\": ${neg_val}}")
  }

  out.print("], \"token_count\": 0, \"budget_remaining\": 2000}")
}

fn escape_json(s: String) -> String{
  let mut result = StringBuffer.new
  for c in s.chars {
    match c {
      case '"' -> {
        result.push('\\')
        result.push('"')
      }
      case '\\' -> {
        result.push('\\')
        result.push('\\')
      }
      case '\n' -> {
        result.push('\\')
        result.push('n')
      }
      case '\r' -> {
        result.push('\\')
        result.push('r')
      }
      case '\t' -> {
        result.push('\\')
        result.push('t')
      }
      case _ -> {
        result.push(c)
      }
    }
  }
  result.into_string
}
